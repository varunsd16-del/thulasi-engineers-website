---
import BaseLayout from '../layouts/engineering-authority-layout.astro';
import Hero from '../components/features/services/premium-hero-construction.astro';
import Welcome from '../components/features/services/turnkey-authority-ribbon.astro';
import ServicesCard from '../components/features/services/construction-services-card.astro';
import ProjectCard from '../components/features/projects/portfolio-project-card.astro';
import StatsBar from '../components/features/services/StatsBar.astro';

import ContactMini from '../components/features/contact/ContactMini.astro';
import FAQ from '../components/features/seo/FAQ.astro';
import AreasServed from '../components/features/seo/trichy-locality-showcase.astro';
import Process from '../components/features/services/Process.astro';
import ProjectShowcase from '../components/features/projects/dynamic-project-masonry.astro';
import OngoingProjectsShowcase from '../components/features/projects/ongoing-projects-showcase.astro';
import { SITE_METADATA } from '../app/config/site.ts';

// SEO Metadata for Homepage
const pageTitle = `Premium Builders in Trichy | ${SITE_METADATA.name}`;
const pageDescription = SITE_METADATA.description;
const pageKeywords = "best builders in trichy, top construction company trichy, civil engineers in trichy, building contractors trichy, luxury house construction trichy";

// Master Service List - Keyword Optimized
const featuredServices = [
  {
    title: "Residential Building Construction in Trichy",
    desc: "As the premier builders in Trichy, we specialize in high-end residential construction. From smart homes to modern luxury villas, our expert civil engineers ensure every project is built with precision and durability.",
    img: "/images/services/residential-commercial-building-construction-trichy.webp",
    link: "/residential-construction-trichy",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`
  },
  {
    title: "Commercial Construction Contractors",
    desc: "Leading commercial building contractors delivering modern office spaces, retail complexes, and hospitality projects. Turnkey construction solutions focused on functionality, ROI, and contemporary architecture.",
    img: "/images/services/commercial-building-construction-services-trichy.webp",
    link: "/services/building-construction",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`
  },
  {
    title: "Project Management Consultant (PMC)",
    desc: "Professional project management consultancy for seamless construction execution. We oversee budgeting, scheduling, BOQ preparation, quality control, and vendor management.",
    img: "/images/services/pmc-project-management-consultants-trichy.webp",
    link: "/services/project-management",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg>`
  }
];

// Featured Projects Data
const featuredProjects = [
  {
    title: "Modern Residential Villa",
    category: "Residential",
    location: "Srirangam, Trichy",
    img: "/images/localities/architectural-plans-approval-verification-trichy.webp"
  },
  {
    title: "Corporate Office Hub",
    category: "Commercial",
    location: "Thillai Nagar, Trichy",
    img: "/images/localities/project-management-procurement-cost-tracking-trichy.webp"
  },
  {
    title: "Industrial Storage Unit",
    category: "Industrial",
    location: "Thuvakudi, Trichy",
    img: "/images/localities/construction-site-ppe-compliance-safety-check-trichy.webp"
  }
];
---

<BaseLayout 
  title={pageTitle} 
  description={pageDescription} 
  keywords={pageKeywords}
  activeNav="home"
  preloadImage="/images/hero/thulasi-engineers-construction-company-trichy.webp"
>
  <!-- 1. Hero Section -->
  <Hero />
  
  <!-- 2. Statistics & Trust Indicators -->
  <StatsBar />

  <!-- 3. Welcome / About Section -->
  <Welcome />

  <!-- 4. Project Showcase Gallery -->
  <ProjectShowcase />

  <!-- Ongoing Projects Section -->
  <OngoingProjectsShowcase />

  <!-- 5. Construction Process -->
  <Process />

  <!-- 6. Optimized Service Cards -->
  <section class="spatial-section services-section reveal-up">
    <div class="container">
      <div class="section-header reveal-up">
        <div class="section-badge">EXPERT CIVIL ENGINEERS</div>
        <h2 class="section-title">Comprehensive <span class="text-gold">Construction</span> & Engineering</h2>
        <div class="heading-accent-line"></div>
        <p class="section-desc">From initial architectural planning to final handover, we provide end-to-end building solutions in Tiruchirappalli. Engineered for the future.</p>
      </div>

      <div class="services-grid">
        {featuredServices.map((service, index) => (
          <div class="reveal-up" style={`transition-delay: ${index * 0.15}s`}>
            <ServicesCard {...service} />
          </div>
        ))}
      </div>

      <div class="section-actions text-center reveal-up">
        <a href="/services" class="btn-outline-navy magnetic-elem">
          <span class="btn-text">Explore All Services →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 7. Why Choose Us Section -->
  <section class="why-section reveal-up">
    <div class="container">
      <div class="why-grid">
        <div class="why-content">
          <div class="section-badge">TRICHY'S #1 BUILDERS</div>
          <h2 class="section-title reveal-up" style="transition-delay: 0.1s;">Building Excellence with <span class="text-gold">Integrity</span></h2>
          <p class="section-desc reveal-up" style="transition-delay: 0.2s;">
            Choosing the right building contractors is crucial for the success of your dream space. Thulasi Engineers & Contractors stands out due to our absolute commitment to structural quality, transparency, and architectural innovation.
          </p>
          
          <ul class="why-list">
            <li class="reveal-up" style="transition-delay: 0.3s;">
              <div class="list-icon"></div>
              <div><strong>Expert Site Engineers:</strong> Dedicated professional site management ensuring flawless execution.</div>
            </li>
            <li class="reveal-up" style="transition-delay: 0.4s;">
              <div class="list-icon"></div>
              <div><strong>Premium Materials:</strong> Only certified, high-grade building materials used for structural longevity.</div>
            </li>
            <li class="reveal-up" style="transition-delay: 0.5s;">
              <div class="list-icon"></div>
              <div><strong>Smart Engineering:</strong> Advanced structural solutions balancing budget with luxury aesthetics.</div>
            </li>
            <li class="reveal-up" style="transition-delay: 0.6s;">
              <div class="list-icon"></div>
              <div><strong>Regulatory Compliance:</strong> Complete assistance with DTCP layouts and government approvals.</div>
            </li>
          </ul>
        </div>
        <div class="why-image-wrapper reveal-up" style="transition-delay: 0.3s;">
          <img src="/images/localities/vastu-compliant-architectural-drafting-office-trichy.webp" alt="Construction project management in Trichy" class="why-image" />
          <div class="image-accent-border"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Featured Projects Showcase -->
  <section class="projects-section reveal-up">
    <div class="container">
      <div class="section-header reveal-up">
        <div class="section-badge">PORTFOLIO</div>
        <h2 class="section-title">Our Featured <span class="text-gold">Landmarks</span></h2>
        <div class="heading-accent-line"></div>
        <p class="section-desc">Explore our successfully completed residential and commercial projects across Trichy, Srirangam, and Thillai Nagar.</p>
      </div>

      <div class="projects-grid">
        {featuredProjects.map((project, index) => (
          <div class="reveal-up" style={`transition-delay: ${index * 0.15}s`}>
            <ProjectCard {...project} />
          </div>
        ))}
      </div>

      <div class="section-actions text-center reveal-up">
        <a href="/projects" class="btn-gold magnetic-elem">
          <span class="btn-text">View Full Gallery</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 9. Areas We Serve (Local SEO) -->
  <AreasServed />

  <!-- 10. FAQ Section -->
  <FAQ />



  <!-- 12. Final CTA Section -->
  <section class="cta-section reveal-up">
    <div class="container">
      <div class="cta-card">
        <div class="cta-glow"></div>
        <div class="cta-content">
          <h3>Ready to Engineer Your <span class="text-gold">Dream Space?</span></h3>
          <p>Get a free consultation and estimation for your residential or commercial project. Speak directly with our lead structural engineers today.</p>
        </div>
        <div class="cta-buttons">
          <a href={`https://wa.me/${SITE_METADATA.whatsapp.replace('+', '')}`} class="btn-gold magnetic-elem" target="_blank" rel="noopener noreferrer">
            <span class="btn-text">Chat on WhatsApp</span>
          </a>
          <a href={`tel:${SITE_METADATA.phone.replace(/\s/g, '')}`} class="btn-outline-white magnetic-elem">
            <span class="btn-text">Call Now</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 13. Contact Mini Form -->
  <ContactMini />

</BaseLayout>

<style>
  /* ── CSS Variables ── */
  :root {
    --navy: #0d1b3e;
    --gold: #c5a059;
    --gold-light: #d4af37;
    --text-dark: #0d1b3e;
    --text-muted: #4b5563;
    --text-light: #6b7280;
    --bg-white: #ffffff;
    --bg-light: #f8fafc;
    --border-light: rgba(13, 27, 62, 0.08);
  }

  /* ── Base Section Styles ── */
  .spatial-section {
    padding: 70px 0;
    position: relative;
    background: var(--bg-white);
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 60px;
  }

  /* Section Header */
  .section-header {
    margin-bottom: 40px;
    max-width: 800px;
  }

  .section-badge {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--gold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 15px;
    display: inline-block;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--navy);
    margin-bottom: 20px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .text-gold {
    color: var(--gold);
  }

  .heading-accent-line {
    width: 60px;
    height: 2px;
    background: var(--gold);
    margin: 20px 0 25px 0;
  }

  .center-line {
    margin: 20px auto 25px auto;
  }

  .section-desc {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 650px;
  }

  .center-desc {
    margin: 0 auto;
  }

  .text-center {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Services Section */
  .services-section {
    background: var(--bg-white);
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 30px;
    margin-bottom: 50px;
  }

  /* Projects Section */
  .projects-section {
    background: var(--bg-light);
    padding: 70px 0;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 30px;
    margin-bottom: 50px;
  }

  /* Section Actions */
  .section-actions {
    margin-top: 40px;
  }

  /* Why Choose Us Section */
  .why-section {
    padding: 70px 0;
    background: var(--bg-white);
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }

  .why-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .why-list {
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    list-style: none;
    padding: 0;
  }

  .why-list li {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .why-list strong {
    color: var(--navy);
    font-weight: 700;
  }

  .list-icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    background: rgba(197, 160, 89, 0.1);
    border: 1px solid rgba(197, 160, 89, 0.3);
    border-radius: 50%;
    position: relative;
    margin-top: 2px;
  }

  .list-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 6px;
    height: 6px;
    background: var(--gold);
    border-radius: 50%;
  }

  .why-image-wrapper {
    position: relative;
    padding-right: 20px;
    padding-bottom: 20px;
  }

  .why-image {
    width: 100%;
    height: auto;
    border-radius: 8px;
    position: relative;
    z-index: 2;
    transition: filter 0.5s ease;
    box-shadow: 0 20px 35px rgba(0, 0, 0, 0.05);
  }

  .image-accent-border {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 90%;
    height: 90%;
    border: 1.5px solid var(--gold);
    border-radius: 8px;
    z-index: 1;
    opacity: 0.5;
    transform: translate(20px, 20px);
    transition: transform 0.5s ease;
  }

  .why-image-wrapper:hover .image-accent-border {
    transform: translate(10px, 10px);
  }

  /* CTA Section */
  .cta-section {
    padding: 80px 0;
    background: var(--bg-white);
  }

  .cta-card {
    position: relative;
    background: linear-gradient(135deg, var(--navy) 0%, #1a2b5e 100%);
    border-radius: 20px;
    padding: 60px 80px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 60px;
    overflow: hidden;
  }

  .cta-glow {
    position: absolute;
    top: -50%;
    left: -20%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(197, 160, 89, 0.15) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .cta-content {
    position: relative;
    z-index: 2;
  }

  .cta-content h3 {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 800;
    margin-bottom: 15px;
    line-height: 1.2;
    color: #ffffff;
  }

  .cta-content p {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.8);
    max-width: 500px;
    line-height: 1.6;
  }

  .cta-buttons {
    position: relative;
    z-index: 2;
    display: flex;
    gap: 20px;
    flex-shrink: 0;
  }

  /* Buttons */
  .btn-outline-navy {
    display: inline-block;
    background: transparent;
    color: var(--navy);
    border: 1.5px solid var(--navy);
    padding: 12px 28px;
    font-weight: 700;
    font-size: 0.75rem;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 4px;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .btn-outline-navy:hover {
    background: var(--navy);
    color: #ffffff;
    transform: translateY(-2px);
  }

  .btn-gold {
    display: inline-block;
    background: var(--gold);
    color: var(--navy);
    border: none;
    padding: 12px 28px;
    font-weight: 700;
    font-size: 0.75rem;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 4px;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .btn-gold:hover {
    background: var(--gold-light);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(197, 160, 89, 0.3);
  }

  /* Reveal Animation */
  .reveal-up {
    opacity: 0;
    transform: translateY(30px);
    animation: revealUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes revealUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .container {
      padding: 0 40px;
    }

    .why-grid {
      grid-template-columns: 1fr;
      gap: 60px;
    }

    .why-image-wrapper {
      order: -1;
      max-width: 600px;
      margin: 0 auto;
    }

    .cta-card {
      flex-direction: column;
      text-align: center;
      padding: 50px 40px;
    }

    .cta-content p {
      max-width: 100%;
    }

    .cta-buttons {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 768px) {
    .spatial-section,
    .why-section,
    .projects-section {
      padding: 60px 0;
    }

    .container {
      padding: 0 24px;
    }

    .services-grid,
    .projects-grid {
      grid-template-columns: 1fr;
    }

    .cta-card {
      padding: 40px 24px;
    }

    .cta-buttons {
      flex-direction: column;
      width: 100%;
    }

    .cta-buttons a {
      text-align: center;
    }

    .section-title {
      font-size: 1.8rem;
    }

    .section-desc {
      font-size: 0.95rem;
    }
  }

  @media (min-width: 1400px) {
    .container {
      padding: 0 80px;
    }

    .services-grid {
      gap: 35px;
    }
  }
</style>