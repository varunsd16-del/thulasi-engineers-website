---
import BaseLayout from '../layouts/engineering-authority-layout.astro';
import ContactMini from '../components/features/contact/ContactMini.astro';
import { SITE_METADATA } from '../app/config/site.ts';

const pageTitle = `Areas We Serve | Best Builders & Civil Engineers in Trichy | ${SITE_METADATA.name}`;
const pageDescription = SITE_METADATA.description;
const pageKeywords = "builders in Thillai Nagar, construction company Srirangam, civil engineers K.K. Nagar Trichy, building contractors No.1 Tollgate, best builders in Trichy areas";

const serviceAreas = [
  {
    name: "Thillai Nagar",
    desc: "The heart of Trichy's premium residential and commercial hub. We specialize in luxury apartments and modern commercial spaces here.",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="2"/><line x1="7" y1="2" x2="7" y2="22"/><line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="2" y1="7" x2="22" y2="7"/><line x1="2" y1="17" x2="22" y2="17"/></svg>`
  },
  {
    name: "Srirangam",
    desc: "Providing culturally sensitive and structurally superior home construction in the temple city of Srirangam.",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`
  },
  {
    name: "K.K. Nagar",
    desc: "Developing modern gated communities and individual villas in one of Trichy's most planned neighborhoods.",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`
  },
  {
    name: "No.1 Tollgate",
    desc: "Our home base. We are the leading building contractors for the rapidly developing Tollgate and Samayapuram regions.",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`
  },
  {
    name: "Woraiyur",
    desc: "Expert civil engineering services for residential renovations and new builds in the historic Woraiyur area.",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.77 3.77z"/></svg>`
  },
  {
    name: "Tiruverumbur",
    desc: "Supporting the industrial and residential growth near BHEL and NIT Trichy with robust construction solutions.",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 20V9l4-2 4 2 4-2 4 2 4-2v11a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2z"/><path d="M18 11v4"/><path d="M14 11v4"/><path d="M10 11v4"/><path d="M6 11v4"/></svg>`
  },
  {
    name: "Kattur",
    desc: "Reliable construction partners for the growing housing needs in the Kattur and Pappakurichi areas.",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`
  },
  {
    name: "Lalgudi & Manachanallur",
    desc: "Extending our engineering excellence to the suburban outskirts, building sustainable homes for families.",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription} keywords={pageKeywords} activeNav="areas">
  <!-- ── Page Banner ── -->
  <section class="page-banner">
    <div class="page-banner__bg">
      <img src="/images/localities/residential-villa-brickwork-ongoing-kk-nagar.webp" alt="Thulasi Engineers - Areas We Serve in Trichy" class="banner-img" />
      <div class="page-banner__overlay"></div>
    </div>
    <div class="container page-banner__content reveal-up">
      <div class="section-badge">LOCATIONS</div>
      <h1 class="page-banner__title">AREAS <span class="text-gold">WE SERVE</span></h1>
      <p class="page-banner__subtitle">Delivering Engineering Excellence Across the Length and Breadth of Trichy.</p>
      
      <nav class="breadcrumb">
        <a href="/" class="magnetic-elem">Home</a>
        <span class="sep">/</span>
        <span class="current">Areas We Serve</span>
      </nav>
    </div>

    <!-- Wave Separator -->
    <div class="banner-wave">
      <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M985.66,92.83C906.67,72,823.78,31,743.84,14.19c-82.26-17.34-168.06-16.33-250.45.39-57.84,11.73-114,31.07-172,41.86A600.21,600.21,0,0,1,0,27.35V120H1200V95.8C1132.19,118.92,1055.71,111.31,985.66,92.83Z" class="shape-fill"></path>
      </svg>
    </div>
  </section>

  <!-- ── Intro Section ── -->
  <section class="areas-intro">
    <div class="container">
      <div class="intro-grid">
        <div class="intro-content" data-aos="fade-up">
          <div class="section-label">LOCAL CONSTRUCTION EXPERTS</div>
          <h2 class="section-title">Your Local <span>Construction</span> Partner in Trichy</h2>
          <p>
            As one of the most established <strong>civil engineers in Trichy</strong>, Thulasi Engineers & Contractors has deep roots across the district. We understand the unique soil conditions, local regulations, and architectural preferences of every neighborhood in Tiruchirappalli.
          </p>
          <p>
            Whether you are looking for <strong>builders in Thillai Nagar</strong> for a commercial project or a <strong>construction company in Srirangam</strong> for your dream home, we provide localized expertise that ensures your project is successful, compliant, and built to last.
          </p>
        </div>
        <div class="intro-stats" data-aos="fade-left">
          <div class="stat-box">
            <strong>30+</strong>
            <span>Projects Completed</span>
          </div>
          <div class="stat-box">
            <span>Serving</span>
            <strong>15+</strong>
            <span>Neighborhoods</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Areas Grid ── -->
  <section class="areas-grid-section">
    <div class="container">
      <div class="section-header text-center" data-aos="fade-up">
        <div class="section-label">NEIGHBORHOODS WE COVER</div>
        <h2 class="section-title">Major Service <span>Regions</span></h2>
      </div>

      <div class="areas-grid">
        {serviceAreas.map((area) => (
          <div class="area-card" data-aos="fade-up">
            <div class="area-card__icon" set:html={area.icon} />
            <h3 class="area-card__name">{area.name}</h3>
            <p class="area-card__desc">{area.desc}</p>
            <a href="/contact" class="area-card__link">Inquire for this area →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── SEO Content Block ── -->
  <section class="local-seo-content">
    <div class="container">
      <div class="seo-card" data-aos="fade-up">
        <h3>The Trusted <span>Building Contractors</span> for Trichy's Growth</h3>
        <p>
          Trichy is rapidly evolving, and we are proud to be at the forefront of this transformation. From the bustling streets of <strong>Chatram Bus Stand</strong> to the serene residential blocks of <strong>Vayalur Road</strong>, our construction footprints are everywhere. 
        </p>
        <p>
          We aren't just <strong>builders in Trichy</strong>; we are partners in community growth. Our team of <strong>registered civil engineers</strong> ensures that every brick laid in <strong>K.K. Nagar</strong> or <strong>No.1 Tollgate</strong> meets the highest national safety standards while catering to the specific aesthetic needs of the local residents.
        </p>
      </div>
    </div>
  </section>

  <ContactMini />
</BaseLayout>

<style>
  /* --- Banner --- */
  .page-banner {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: center;
    background: var(--navy);
    overflow: visible;
    padding-top: 140px;
    padding-bottom: 120px;
    border: none !important;
  }

  .banner-wave {
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    z-index: 5;
  }

  .banner-wave svg {
    position: relative;
    display: block;
    width: calc(100% + 1.3px);
    height: 80px;
    transform: translateY(1px);
  }

  .banner-wave .shape-fill {
    fill: var(--bg-white);
  }

  .page-banner__bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.25;
  }

  .page-banner__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--navy) 0%, rgba(13, 27, 62, 0.85) 50%, rgba(13, 27, 62, 0.7) 100%);
    z-index: 2;
  }

  .page-banner__title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    color: #ffffff;
    margin-bottom: 20px;
  }

  .text-gold {
    color: var(--gold);
  }

  .page-banner__subtitle {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    margin-bottom: 30px;
    max-width: 600px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .breadcrumb a:hover {
    color: var(--gold);
  }

  .breadcrumb .sep {
    color: rgba(255, 255, 255, 0.4);
  }

  .breadcrumb .current {
    color: var(--gold);
  }

  .section-badge {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--gold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 15px;
    display: inline-block;
  }

  .reveal-up {
    opacity: 0;
    transform: translateY(30px);
    animation: revealUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes revealUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* --- Intro --- */
  .areas-intro { padding: 100px 0; background: #fff; }
  .section-title {
    color: var(--navy);
  }
  .section-title span {
    color: var(--primary);
  }
  .intro-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 60px; align-items: center; }
  .intro-content p { font-size: 1.1rem; line-height: 1.8; color: var(--text-body); margin-bottom: 20px; }
  
  .intro-stats { display: flex; flex-direction: column; gap: 20px; }

  .stat-box { 
    background: #ffffff; 
    padding: 40px; 
    border-radius: 20px; 
    border: 1px solid rgba(13, 27, 62, 0.08);
    border-left: 5px solid var(--primary); 
    display: flex; 
    flex-direction: column; 
    gap: 5px; 
    box-shadow: 0 15px 35px rgba(13, 27, 62, 0.04);
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
  }
  .stat-box:hover {
    transform: translateY(-5px);
    box-shadow: 0 25px 50px rgba(13, 27, 62, 0.08);
    border-color: rgba(197, 160, 89, 0.3);
    border-left-color: var(--primary);
  }
  .stat-box strong { font-size: 3rem; color: var(--primary); font-family: var(--font-head); line-height: 1; }
  .stat-box span { font-weight: 700; color: var(--black); text-transform: uppercase; font-size: 0.8rem; letter-spacing: 1px; }

  /* --- Grid --- */
  .areas-grid-section { padding: 100px 0; background: #fcfcfc; }
  .areas-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 30px; margin-top: 60px; }
  
  .area-card { 
    background: #fff; 
    padding: 50px 40px; 
    border-radius: 24px; 
    border: 1px solid #e5e7eb; /* More visible border */
    transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
    display: flex;
    flex-direction: column;
  }
  .area-card:hover { transform: translateY(-12px); box-shadow: 0 40px 80px rgba(0,0,0,0.06);    border-color: rgba(197, 160, 89, 0.3); }
  
  .area-card__icon { 
    width: 64px;
    height: 64px;
    background: #fdfdfd;
    border: 1px solid #e5e7eb;
    color: var(--primary);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 30px;
    transition: all 0.4s;
  }
  .area-card:hover .area-card__icon { background: var(--primary); color: #fff; border-color: var(--primary); transform: rotate(5deg) scale(1.1); }
  .area-card__icon :global(svg) { width: 28px; height: 28px; }
  .area-card__name { font-size: 1.4rem; font-weight: 800; color: var(--black); margin-bottom: 15px; font-family: var(--font-head); }
  .area-card__desc { font-size: 0.95rem; color: var(--text-body); line-height: 1.6; margin-bottom: 25px; flex-grow: 1; }
  .area-card__link { font-size: 0.85rem; font-weight: 700; color: var(--primary); text-decoration: none; text-transform: uppercase; letter-spacing: 0.5px; }

  /* --- SEO Content --- */
  .local-seo-content { padding: 80px 0; background: #fff; }
  .seo-card { 
    background: var(--navy); 
    color: #ffffff; 
    padding: 60px; 
    border-radius: 32px; 
    box-shadow: 0 30px 60px rgba(13, 27, 62, 0.2); 
  }
  .seo-card h3 { 
    color: #ffffff; 
    font-size: 2rem; 
    font-weight: 800; 
    margin-bottom: 25px; 
    font-family: var(--font-head); 
  }
  .seo-card h3 span { color: var(--primary); }
  .seo-card p { 
    color: rgba(255, 255, 255, 0.85); 
    font-size: 1.1rem; 
    line-height: 1.8; 
    margin-bottom: 20px; 
  }
  .seo-card strong { 
    color: #ffffff; 
    font-weight: 700; 
  }

  @media (max-width: 1024px) {
    .intro-grid { grid-template-columns: 1fr; }
    .page-banner__title { font-size: 2.8rem; }
  }

  @media (max-width: 640px) {
    .seo-card { padding: 40px 25px; }
    .area-card { padding: 30px; }
    .page-banner { 
      min-height: 40vh; 
      padding-top: 120px; 
      padding-bottom: 80px; 
    }
  }
</style>
