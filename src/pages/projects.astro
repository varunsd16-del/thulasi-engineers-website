---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/engineering-authority-layout.astro';

// Read all images dynamically from public/images/localities
const localitiesDir = path.resolve('public/images/localities');
let localitiesFiles = [];
try {
  localitiesFiles = fs.readdirSync(localitiesDir);
} catch (err) {
  console.error("Error reading localities directory:", err);
}

// Read all images dynamically from public/images/ongoing projects
const ongoingDir = path.resolve('public/images/ongoing projects');
let ongoingFiles = [];
try {
  ongoingFiles = fs.readdirSync(ongoingDir);
} catch (err) {
  console.error("Error reading ongoing projects directory:", err);
}

const localitiesImages = localitiesFiles
  .filter(file => /\.(webp|png|jpe?g|svg)$/i.test(file))
  .map(filename => ({
    filename,
    src: `/images/localities/${filename}`
  }));

const ongoingImages = ongoingFiles
  .filter(file => /\.(webp|png|jpe?g|svg)$/i.test(file))
  .map(filename => ({
    filename,
    src: `/images/ongoing projects/${filename}`
  }));

const allImages = [...localitiesImages, ...ongoingImages];

function getCategory(filename) {
  const lower = filename.toLowerCase();
  if (lower.includes('villa') || lower.includes('residence') || lower.includes('residential') || lower.includes('home') || lower.includes('house') || lower.includes('apartment') || lower.includes('brickwork') || lower.includes('plastering')) {
    return 'residential';
  }
  if (lower.includes('commercial') || lower.includes('office') || lower.includes('retail') || lower.includes('complex') || lower.includes('drafting') || lower.includes('architectural') || lower.includes('plans')) {
    return 'commercial';
  }
  if (lower.includes('peb') || lower.includes('industrial') || lower.includes('warehouse') || lower.includes('shed') || lower.includes('fabrication') || lower.includes('concrete') || lower.includes('framing')) {
    return 'industrial';
  }
  if (lower.includes('infrastructure') || lower.includes('road') || lower.includes('drain') || lower.includes('sewage') || lower.includes('asphalt') || lower.includes('civil')) {
    return 'infrastructure';
  }
  return 'residential';
}

function getTitle(filename) {
  let name = filename.replace(/\.(webp|png|jpe?g)$/i, '');
  
  // List of location suffixes/keywords to strip from the title
  const locationKeys = [
    'thillai-nagar', 'kk-nagar', 'golden-rock', 
    'srirangam', 'woraiyur', 'cantonment', 'karumandapam',
    'puthur', 'tiruverumbur', 'samayapuram', 'lalgudi',
    'manapparai', 'thuvakudi', 'panjapur', 'trichy', 'thulasi-engineers'
  ];

  let lowerName = name.toLowerCase();
  for (const key of locationKeys) {
    if (lowerName.includes(key)) {
      const regex = new RegExp(`-?in-?${key}|-?${key}`, 'gi');
      name = name.replace(regex, '');
      lowerName = name.toLowerCase();
    }
  }

  // Remove trailing/leading hyphens if any
  name = name.replace(/^-+|-+$/g, '');

  return name
    .split('-')
    .map(word => {
      const upper = word.toUpperCase();
      if (upper === 'PEB') return 'PEB';
      if (upper === 'AAC') return 'AAC';
      if (upper === 'PPE') return 'PPE';
      if (upper === 'PMC') return 'PMC';
      return word.charAt(0).toUpperCase() + word.slice(1);
    })
    .join(' ');
}

function getLocation(filename) {
  const name = filename.replace(/\.(webp|png|jpe?g)$/i, '').toLowerCase();
  
  const locations = [
    { key: 'srirangam', display: 'Srirangam, Trichy' },
    { key: 'thillai-nagar', display: 'Thillai Nagar, Trichy' },
    { key: 'kk-nagar', display: 'KK Nagar, Trichy' },
    { key: 'woraiyur', display: 'Woraiyur, Trichy' },
    { key: 'cantonment', display: 'Cantonment, Trichy' },
    { key: 'karumandapam', display: 'Karumandapam, Trichy' },
    { key: 'puthur', display: 'Puthur, Trichy' },
    { key: 'tiruverumbur', display: 'Tiruverumbur, Trichy' },
    { key: 'samayapuram', display: 'Samayapuram, Trichy' },
    { key: 'golden-rock', display: 'Golden Rock, Trichy' },
    { key: 'lalgudi', display: 'Lalgudi, Trichy' },
    { key: 'manapparai', display: 'Manapparai, Trichy' },
    { key: 'thuvakudi', display: 'Thuvakudi, Trichy' },
    { key: 'panjapur', display: 'Panjapur, Trichy' },
    { key: 'trichy', display: 'Trichy, Tamil Nadu' }
  ];

  for (const loc of locations) {
    if (name.includes(loc.key)) {
      return loc.display;
    }
  }
  return 'Trichy, Tamil Nadu';
}

const projects = allImages.map((item, index) => {
  const category = getCategory(item.filename);
  const title = getTitle(item.filename);
  const location = getLocation(item.filename);
  
  // Distribute layout types (large, tall, regular) for a beautiful masonry look
  let layoutClass = '';
  if (index % 7 === 0) {
    layoutClass = 'project-large';
  } else if (index % 7 === 4) {
    layoutClass = 'project-tall';
  }
  
  return {
    src: item.src,
    alt: title,
    title,
    category,
    location,
    layoutClass,
    delay: `${0.05 * (index % 8)}s`
  };
});
---

<BaseLayout title="Projects — Thulasi Engineers & Contractors" activeNav="projects">
  <!-- Cinematic Page Banner -->
  <section class="page-banner">
    <div class="page-banner__bg">
      <img src="/images/localities/residential-house-structural-columns-woraiyur.webp" alt="Thulasi Engineers Projects - Best Builders in Trichy" class="banner-img" />
      <div class="page-banner__overlay"></div>
    </div>
    <div class="container page-banner__content reveal-up">
      <div class="section-badge">OUR PORTFOLIO</div>
      <h1 class="page-banner__title">FEATURED <span class="text-gold">PROJECTS</span></h1>
      <p class="page-banner__subtitle">Explore our legacy of structural excellence and architectural innovation across Trichy.</p>
      
      <nav class="breadcrumb">
        <a href="/" class="magnetic-elem">Home</a>
        <span class="sep">/</span>
        <span class="current">Projects</span>
      </nav>
    </div>

    <!-- Wave Separator -->
    <div class="banner-wave">
      <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M985.66,92.83C906.67,72,823.78,31,743.84,14.19c-82.26-17.34-168.06-16.33-250.45.39-57.84,11.73-114,31.07-172,41.86A600.21,600.21,0,0,1,0,27.35V120H1200V95.8C1132.19,118.92,1055.71,111.31,985.66,92.83Z" class="shape-fill"></path>
      </svg>
    </div>
  </section>


  <!-- Modern Project Grid with Masonry Layout -->
  <section class="modern-projects">
    <div class="container">
      <div class="projects-masonry">
        {projects.map((project) => (
          <div class={`project-item ${project.layoutClass} reveal-up`} style={`transition-delay: ${project.delay};`} data-category={project.category}>
            <div class="project-item__image">
              <img src={project.src} alt={project.alt} loading="eager" decoding="async" />
              <div class="project-item__overlay">
                <div class="project-item__details">
                  <span class="project-item__category">{project.category}</span>
                  <h3 class="project-item__title">{project.title}</h3>
                  <p class="project-item__location">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="location-icon"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                    {project.location}
                  </p>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Feature Story Section -->
  <section class="feature-story">
    <div class="container">
      <div class="feature-story__grid">
        <div class="feature-story__content reveal-up">
          <div class="section-badge">FEATURE STORY</div>
          <h2 class="feature-story__title">Engineering Excellence in <span class="text-gold">Trichy</span></h2>
          <p class="feature-story__desc">
            Thulasi Engineers & Contractors has established itself as the leading building contractor in Trichy, delivering a diverse portfolio of successful projects since 2014.
          </p>
          <div class="feature-stats">
            <div class="feature-stat">
              <div class="feature-stat__num">10+</div>
              <div class="feature-stat__label">Years of Excellence</div>
            </div>
            <div class="feature-stat">
              <div class="feature-stat__num">100%</div>
              <div class="feature-stat__label">Client Satisfaction</div>
            </div>
            <div class="feature-stat">
              <div class="feature-stat__num">A-Class</div>
              <div class="feature-stat__label">Contractor Status</div>
            </div>
          </div>
        </div>
        <div class="feature-story__image reveal-up" style="animation-delay: 0.2s;">
          <img src="/images/localities/vastu-compliant-architectural-drafting-office-trichy.webp" alt="Featured Construction Project" />
          <div class="image-accent"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="projects-cta">
    <div class="container">
      <div class="cta-card">
        <div class="cta-card__content">
          <h3>Ready to Build Your <span class="text-gold">Masterpiece?</span></h3>
          <p>Let's discuss your project and turn your vision into reality</p>
          <a href="/contact" class="btn-gold">Start Your Journey →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :root {
    --navy: #0d1b3e;
    --gold: #c5a059;
    --gold-light: #d4af37;
    --text-muted: #4b5563;
    --bg-white: #ffffff;
    --bg-light: #f8fafc;
    --border-light: rgba(13, 27, 62, 0.08);
  }

  /* Page Banner */
  .page-banner {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: center;
    background: var(--navy);
    overflow: visible;
    padding-top: 140px;
    padding-bottom: 120px;
    border: none !important;
  }

  .page-banner__bg {
    position: absolute;
    inset: 0;
  }

  .page-banner__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-banner__overlay {
    position: absolute;
    inset: 0;
    background: rgba(13, 27, 62, 0.85);
  }

  .page-banner__content {
    position: relative;
    z-index: 2;
    color: #fff;
    text-align: center;
  }

  .page-banner__title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    margin: 20px 0;
    color: #ffffff;
  }

  .page-banner__subtitle {
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto 30px;
    color: #ffffff;
    opacity: 1;
  }

  .banner-wave {
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    z-index: 5;
  }

  .banner-wave svg {
    position: relative;
    display: block;
    width: calc(100% + 1.3px);
    height: 80px;
    transform: translateY(1px);
  }

  .banner-wave .shape-fill {
    fill: var(--bg-white);
  }

  .breadcrumb {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .breadcrumb a {
    color: var(--gold);
    text-decoration: none;
  }

  .breadcrumb .sep {
    margin: 0 10px;
    opacity: 0.5;
  }

  /* Category Showcase */
  .category-showcase {
    padding: 60px 0;
    background: var(--bg-white);
  }

  .category-showcase__header {
    text-align: center;
    margin-bottom: 60px;
  }

  .section-badge {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--gold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 15px;
    display: inline-block;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 800;
    color: var(--navy);
    margin-bottom: 16px;
  }

  .section-desc {
    font-size: 1rem;
    color: var(--text-muted);
    max-width: 600px;
    margin: 0 auto;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
  }

  .category-card {
    text-align: center;
    padding: 30px 20px;
    background: var(--bg-light);
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.3s ease;
    border: 1px solid var(--border-light);
  }

  .category-card:hover,
  .category-card.active {
    background: var(--gold);
    border-color: var(--gold);
    transform: translateY(-5px);
  }

  .category-card:hover .category-icon,
  .category-card.active .category-icon {
    background: var(--bg-white);
    color: var(--gold);
  }

  .category-card:hover h3,
  .category-card.active h3 {
    color: var(--bg-white);
  }

  .category-card:hover span,
  .category-card.active span {
    color: rgba(255, 255, 255, 0.8);
  }

  .category-icon {
    width: 60px;
    height: 60px;
    background: rgba(197, 160, 89, 0.1);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
    transition: all 0.3s ease;
  }

  .category-icon svg {
    width: 30px;
    height: 30px;
    stroke: var(--gold);
  }

  .category-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 8px;
  }

  .category-card span {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* Masonry Grid */
  .modern-projects {
    padding: 60px 0 70px;
    background: var(--bg-white);
  }

  .projects-masonry {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
    grid-auto-flow: dense;
  }

  @media (min-width: 1025px) {
    .project-large {
      grid-column: span 2;
      grid-row: span 2;
    }
    .project-tall {
      grid-row: span 2;
    }
    .project-tall .project-item__image {
      padding-bottom: calc(150% + 24px);
    }
  }

  .project-item {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-item:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(13, 27, 62, 0.12);
  }

  .project-item__image {
    position: relative;
    padding-bottom: 75%;
    overflow: hidden;
  }

  .project-item__image img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .project-item:hover .project-item__image img {
    transform: scale(1.06);
  }

  .project-item__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(13, 27, 62, 0.9) 0%, rgba(13, 27, 62, 0.4) 50%, rgba(13, 27, 62, 0) 100%);
    display: flex;
    align-items: flex-end;
    padding: 30px;
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 2;
  }

  .project-item:hover .project-item__overlay {
    opacity: 1;
  }

  .project-item__details {
    transform: translateY(20px);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    width: 100%;
  }

  .project-item:hover .project-item__details {
    transform: translateY(0);
  }

  .project-item__category {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--gold);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    display: block;
    margin-bottom: 8px;
  }

  .project-item__title {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 8px 0;
    line-height: 1.3;
  }

  .project-item__location {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .location-icon {
    width: 14px;
    height: 14px;
    stroke: var(--gold);
  }

  /* Feature Story */
  .feature-story {
    padding: 70px 0;
    background: var(--bg-light);
  }

  .feature-story__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .feature-story__title {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: var(--navy);
    margin-bottom: 20px;
  }

  .feature-story__desc {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 40px;
  }

  .feature-stats {
    display: flex;
    gap: 40px;
  }

  .feature-stat__num {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--gold);
    line-height: 1;
  }

  .feature-stat__label {
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 5px;
  }

  .feature-story__image {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
  }

  .feature-story__image img {
    width: 100%;
    height: auto;
    border-radius: 20px;
  }

  .image-accent {
    position: absolute;
    bottom: -20px;
    right: -20px;
    width: 100%;
    height: 100%;
    border: 2px solid var(--gold);
    border-radius: 20px;
    z-index: -1;
  }

  /* CTA Section */
  .projects-cta {
    padding: 60px 0 80px;
    background: var(--bg-white);
  }

  .cta-card {
    background: linear-gradient(135deg, var(--navy) 0%, #1a2b5e 100%);
    border-radius: 30px;
    padding: 60px;
    text-align: center;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .cta-card__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
  }

  .cta-card__content h3 {
    font-size: clamp(1.8rem, 3vw, 2.2rem);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 16px;
    text-align: center;
  }

  .cta-card__content p {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 32px;
    text-align: center;
    max-width: 600px;
  }

  .btn-gold {
    display: inline-block;
    background: var(--gold);
    color: var(--navy);
    padding: 14px 36px;
    font-weight: 700;
    font-size: 0.8rem;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 40px;
    transition: all 0.3s ease;
  }

  .btn-gold:hover {
    background: var(--gold-light);
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(197, 160, 89, 0.3);
  }

  /* Reveal Animation */
  .reveal-up {
    opacity: 0;
    transform: translateY(30px);
    animation: revealUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes revealUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .container {
      padding: 0 40px;
    }

    .projects-hero__grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-stats {
      justify-content: center;
    }

    .category-grid {
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    }

    .projects-masonry {
      grid-template-columns: 1fr;
    }

    .project-large,
    .project-tall {
      grid-column: span 1;
      grid-row: span 1;
    }

    .feature-story__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .hero-visual__wrapper {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 24px;
    }

    .projects-hero {
      padding: 100px 0 60px;
    }

    .projects-hero__title {
      font-size: 2rem;
    }

    .hero-stats {
      flex-direction: column;
      gap: 20px;
      align-items: center;
    }

    .category-grid {
      gap: 12px;
    }

    .category-card {
      padding: 20px 12px;
    }

    .category-icon {
      width: 45px;
      height: 45px;
    }

    .category-icon svg {
      width: 22px;
      height: 22px;
    }

    .category-card h3 {
      font-size: 0.8rem;
    }

    .cta-card {
      padding: 40px 24px;
    }
  }
</style>