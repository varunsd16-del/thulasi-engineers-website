---
import BaseLayout from '../layouts/engineering-authority-layout.astro';
---

<BaseLayout title="Projects — Thulasi Engineers & Contractors" activeNav="projects">
  <!-- Cinematic Page Banner -->
  <section class="page-banner">
    <div class="page-banner__bg">
      <img src="/images/localities/residential-house-structural-columns-woraiyur.webp" alt="Thulasi Engineers Projects - Best Builders in Trichy" class="banner-img" />
      <div class="page-banner__overlay"></div>
    </div>
    <div class="container page-banner__content reveal-up">
      <div class="section-badge">OUR PORTFOLIO</div>
      <h1 class="page-banner__title">FEATURED <span class="text-gold">PROJECTS</span></h1>
      <p class="page-banner__subtitle">Explore our legacy of structural excellence and architectural innovation across Trichy.</p>
      
      <nav class="breadcrumb">
        <a href="/" class="magnetic-elem">Home</a>
        <span class="sep">/</span>
        <span class="current">Projects</span>
      </nav>
    </div>

    <!-- Wave Separator -->
    <div class="banner-wave">
      <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M985.66,92.83C906.67,72,823.78,31,743.84,14.19c-82.26-17.34-168.06-16.33-250.45.39-57.84,11.73-114,31.07-172,41.86A600.21,600.21,0,0,1,0,27.35V120H1200V95.8C1132.19,118.92,1055.71,111.31,985.66,92.83Z" class="shape-fill"></path>
      </svg>
    </div>
  </section>

  <!-- Category Showcase -->
  <section class="category-showcase">
    <div class="container">
      <div class="category-showcase__header reveal-up">
        <div class="section-badge">BROWSE BY SECTOR</div>
        <h2 class="section-title">Explore Our <span class="text-gold">Expertise</span></h2>
        <p class="section-desc">Each project tells a unique story of innovation, precision, and excellence</p>
      </div>
      <div class="category-grid">
        <div class="category-card reveal-up" style="transition-delay: 0.05s;" data-category="all">
          <div class="category-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="9" width="18" height="13" rx="1"/><path d="M9 22V12h6v10"/><path d="M3 9l9-7 9 7"/></svg>
          </div>
          <h3>All Projects</h3>
          <span>30+ Projects</span>
        </div>
        <div class="category-card reveal-up" style="transition-delay: 0.1s;" data-category="residential">
          <div class="category-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          </div>
          <h3>Residential</h3>
          <span>15+ Projects</span>
        </div>
        <div class="category-card reveal-up" style="transition-delay: 0.15s;" data-category="commercial">
          <div class="category-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="7" width="20" height="15" rx="1"/><path d="M16 7V5a2 2 0 0 0-8 0v2"/></svg>
          </div>
          <h3>Commercial</h3>
          <span>8+ Projects</span>
        </div>
        <div class="category-card reveal-up" style="transition-delay: 0.2s;" data-category="industrial">
          <div class="category-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="12" width="20" height="10" rx="1"/><path d="M6 12V7l5 5V7l5 5V7l4 5"/></svg>
          </div>
          <h3>Industrial</h3>
          <span>5+ Projects</span>
        </div>
        <div class="category-card reveal-up" style="transition-delay: 0.25s;" data-category="infrastructure">
          <div class="category-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 20h18M5 20V8l7-4 7 4v12"/><path d="M10 20v-6h4v6"/></svg>
          </div>
          <h3>Infrastructure</h3>
          <span>4+ Projects</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Modern Project Grid with Masonry Layout -->
  <section class="modern-projects">
    <div class="container">
      <div class="projects-masonry">
        <!-- Project 1 - Large -->
        <div class="project-item project-large reveal-up" style="transition-delay: 0.05s;" data-category="residential">
          <div class="project-item__image">
            <img src="/images/localities/structural-renovation-plastering-old-home-trichy.webp" alt="Royal Heights Apartments" />
            <div class="project-item__overlay">
              <div class="overlay-content">
                <span class="project-category">Residential</span>
                <h3 class="project-title">Royal Heights Apartments</h3>
                <div class="project-location">Trichy, Tamil Nadu</div>
                <a href="#" class="project-link">View Project →</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Project 2 -->
        <div class="project-item reveal-up" style="transition-delay: 0.1s;" data-category="commercial">
          <div class="project-item__image">
            <img src="/images/localities/vastu-compliant-architectural-drafting-office-trichy.webp" alt="Grand Prime Office Complex" />
            <div class="project-item__overlay">
              <div class="overlay-content">
                <span class="project-category">Commercial</span>
                <h3 class="project-title">Grand Prime Office Complex</h3>
                <div class="project-location">Trichy, Tamil Nadu</div>
                <a href="#" class="project-link">View Project →</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Project 3 -->
        <div class="project-item reveal-up" style="transition-delay: 0.15s;" data-category="industrial">
          <div class="project-item__image">
            <img src="/images/localities/site-supervision-timeline-management-trichy.webp" alt="Sri Venkateshwara Industries" />
            <div class="project-item__overlay">
              <div class="overlay-content">
                <span class="project-category">Industrial</span>
                <h3 class="project-title">Sri Venkateshwara Industries</h3>
                <div class="project-location">Karur, Tamil Nadu</div>
                <a href="#" class="project-link">View Project →</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Project 4 - Large -->
        <div class="project-item project-large reveal-up" style="transition-delay: 0.2s;" data-category="infrastructure">
          <div class="project-item__image">
            <img src="/images/localities/site-safety-officer-construction-briefing-trichy.webp" alt="Trichy Bypass Road Project" />
            <div class="project-item__overlay">
              <div class="overlay-content">
                <span class="project-category">Infrastructure</span>
                <h3 class="project-title">Trichy Bypass Road Project</h3>
                <div class="project-location">Trichy, Tamil Nadu</div>
                <a href="#" class="project-link">View Project →</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Project 5 -->
        <div class="project-item reveal-up" style="transition-delay: 0.25s;" data-category="residential">
          <div class="project-item__image">
            <img src="/images/localities/green-building-aac-block-masonry-trichy.webp" alt="Heritage Home Renovation" />
            <div class="project-item__overlay">
              <div class="overlay-content">
                <span class="project-category">Residential</span>
                <h3 class="project-title">Heritage Home Renovation</h3>
                <div class="project-location">Trichy, Tamil Nadu</div>
                <a href="#" class="project-link">View Project →</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Project 6 -->
        <div class="project-item reveal-up" style="transition-delay: 0.3s;" data-category="industrial">
          <div class="project-item__image">
            <img src="/images/localities/luxury-villa-structural-foundation-casting-srirangam.webp" alt="MJM Steel Fabrication Unit" />
            <div class="project-item__overlay">
              <div class="overlay-content">
                <span class="project-category">Industrial</span>
                <h3 class="project-title">MJM Steel Fabrication Unit</h3>
                <div class="project-location">Pudukottai, Tamil Nadu</div>
                <a href="#" class="project-link">View Project →</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Project 7 -->
        <div class="project-item reveal-up" style="transition-delay: 0.35s;" data-category="residential">
          <div class="project-item__image">
            <img src="/images/localities/ongoing-commercial-retail-complex-cantonment.webp" alt="Green View Villas" />
            <div class="project-item__overlay">
              <div class="overlay-content">
                <span class="project-category">Residential</span>
                <h3 class="project-title">Green View Villas</h3>
                <div class="project-location">Trichy, Tamil Nadu</div>
                <a href="#" class="project-link">View Project →</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Project 8 - Tall -->
        <div class="project-item project-tall reveal-up" style="transition-delay: 0.4s;" data-category="infrastructure">
          <div class="project-item__image">
            <img src="/images/localities/residential-house-structural-columns-woraiyur.webp" alt="Sewage Treatment Plant" />
            <div class="project-item__overlay">
              <div class="overlay-content">
                <span class="project-category">Infrastructure</span>
                <h3 class="project-title">Sewage Treatment Plant</h3>
                <div class="project-location">Trichy, Tamil Nadu</div>
                <a href="#" class="project-link">View Project →</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature Story Section -->
  <section class="feature-story">
    <div class="container">
      <div class="feature-story__grid">
        <div class="feature-story__content reveal-up">
          <div class="section-badge">FEATURE STORY</div>
          <h2 class="feature-story__title">Engineering Excellence in <span class="text-gold">Trichy</span></h2>
          <p class="feature-story__desc">
            Thulasi Engineers & Contractors has established itself as the leading building contractor in Trichy, delivering a diverse portfolio of successful projects since 2014.
          </p>
          <div class="feature-stats">
            <div class="feature-stat">
              <div class="feature-stat__num">10+</div>
              <div class="feature-stat__label">Years of Excellence</div>
            </div>
            <div class="feature-stat">
              <div class="feature-stat__num">100%</div>
              <div class="feature-stat__label">Client Satisfaction</div>
            </div>
            <div class="feature-stat">
              <div class="feature-stat__num">A-Class</div>
              <div class="feature-stat__label">Contractor Status</div>
            </div>
          </div>
        </div>
        <div class="feature-story__image reveal-up" style="animation-delay: 0.2s;">
          <img src="/images/localities/vastu-compliant-architectural-drafting-office-trichy.webp" alt="Featured Construction Project" />
          <div class="image-accent"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="projects-cta">
    <div class="container">
      <div class="cta-card">
        <div class="cta-card__content">
          <h3>Ready to Build Your <span class="text-gold">Masterpiece?</span></h3>
          <p>Let's discuss your project and turn your vision into reality</p>
          <a href="/contact" class="btn-gold">Start Your Journey →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :root {
    --navy: #0d1b3e;
    --gold: #c5a059;
    --gold-light: #d4af37;
    --text-muted: #4b5563;
    --bg-white: #ffffff;
    --bg-light: #f8fafc;
    --border-light: rgba(13, 27, 62, 0.08);
  }

  /* Page Banner */
  .page-banner {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: center;
    background: var(--navy);
    overflow: visible;
    padding-top: 140px;
    padding-bottom: 120px;
    border: none !important;
  }

  .page-banner__bg {
    position: absolute;
    inset: 0;
  }

  .page-banner__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .page-banner__overlay {
    position: absolute;
    inset: 0;
    background: rgba(13, 27, 62, 0.85);
  }

  .page-banner__content {
    position: relative;
    z-index: 2;
    color: #fff;
    text-align: center;
  }

  .page-banner__title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    margin: 20px 0;
    color: #ffffff;
  }

  .page-banner__subtitle {
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto 30px;
    color: #ffffff;
    opacity: 1;
  }

  .banner-wave {
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    z-index: 5;
  }

  .banner-wave svg {
    position: relative;
    display: block;
    width: calc(100% + 1.3px);
    height: 80px;
    transform: translateY(1px);
  }

  .banner-wave .shape-fill {
    fill: var(--bg-white);
  }

  .breadcrumb {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .breadcrumb a {
    color: var(--gold);
    text-decoration: none;
  }

  .breadcrumb .sep {
    margin: 0 10px;
    opacity: 0.5;
  }

  /* Category Showcase */
  .category-showcase {
    padding: 60px 0;
    background: var(--bg-white);
  }

  .category-showcase__header {
    text-align: center;
    margin-bottom: 60px;
  }

  .section-badge {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--gold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 15px;
    display: inline-block;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 800;
    color: var(--navy);
    margin-bottom: 16px;
  }

  .section-desc {
    font-size: 1rem;
    color: var(--text-muted);
    max-width: 600px;
    margin: 0 auto;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
  }

  .category-card {
    text-align: center;
    padding: 30px 20px;
    background: var(--bg-light);
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.3s ease;
    border: 1px solid var(--border-light);
  }

  .category-card:hover,
  .category-card.active {
    background: var(--gold);
    border-color: var(--gold);
    transform: translateY(-5px);
  }

  .category-card:hover .category-icon,
  .category-card.active .category-icon {
    background: var(--bg-white);
    color: var(--gold);
  }

  .category-card:hover h3,
  .category-card.active h3 {
    color: var(--bg-white);
  }

  .category-card:hover span,
  .category-card.active span {
    color: rgba(255, 255, 255, 0.8);
  }

  .category-icon {
    width: 60px;
    height: 60px;
    background: rgba(197, 160, 89, 0.1);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
    transition: all 0.3s ease;
  }

  .category-icon svg {
    width: 30px;
    height: 30px;
    stroke: var(--gold);
  }

  .category-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 8px;
  }

  .category-card span {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* Masonry Grid */
  .modern-projects {
    padding: 60px 0 70px;
    background: var(--bg-white);
  }

  .projects-masonry {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
    grid-auto-flow: dense;
  }

  .project-item {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    cursor: pointer;
  }

  .project-item__image {
    position: relative;
    padding-bottom: 75%;
    overflow: hidden;
  }

  .project-item__image img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .project-item:hover .project-item__image img {
    transform: scale(1.05);
  }

  .project-item__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(13, 27, 62, 0.9) 0%, rgba(13, 27, 62, 0.4) 50%, transparent 100%);
    display: flex;
    align-items: flex-end;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .project-item:hover .project-item__overlay {
    opacity: 1;
  }

  .overlay-content {
    padding: 24px;
    transform: translateY(20px);
    transition: transform 0.4s ease;
  }

  .project-item:hover .overlay-content {
    transform: translateY(0);
  }

  .project-category {
    display: inline-block;
    background: var(--gold);
    color: var(--navy);
    font-size: 0.65rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 20px;
    letter-spacing: 0.05em;
    margin-bottom: 12px;
  }

  .project-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 8px;
  }

  .project-location {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 16px;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--gold);
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    transition: gap 0.3s ease;
  }

  .project-link:hover {
    gap: 12px;
  }

  /* Feature Story */
  .feature-story {
    padding: 70px 0;
    background: var(--bg-light);
  }

  .feature-story__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .feature-story__title {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: var(--navy);
    margin-bottom: 20px;
  }

  .feature-story__desc {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 40px;
  }

  .feature-stats {
    display: flex;
    gap: 40px;
  }

  .feature-stat__num {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--gold);
    line-height: 1;
  }

  .feature-stat__label {
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 5px;
  }

  .feature-story__image {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
  }

  .feature-story__image img {
    width: 100%;
    height: auto;
    border-radius: 20px;
  }

  .image-accent {
    position: absolute;
    bottom: -20px;
    right: -20px;
    width: 100%;
    height: 100%;
    border: 2px solid var(--gold);
    border-radius: 20px;
    z-index: -1;
  }

  /* CTA Section */
  .projects-cta {
    padding: 60px 0 80px;
    background: var(--bg-white);
  }

  .cta-card {
    background: linear-gradient(135deg, var(--navy) 0%, #1a2b5e 100%);
    border-radius: 30px;
    padding: 60px;
    text-align: center;
  }

  .cta-card__content h3 {
    font-size: clamp(1.8rem, 3vw, 2.2rem);
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 16px;
  }

  .cta-card__content p {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 32px;
  }

  .btn-gold {
    display: inline-block;
    background: var(--gold);
    color: var(--navy);
    padding: 14px 36px;
    font-weight: 700;
    font-size: 0.8rem;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 40px;
    transition: all 0.3s ease;
  }

  .btn-gold:hover {
    background: var(--gold-light);
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(197, 160, 89, 0.3);
  }

  /* Reveal Animation */
  .reveal-up {
    opacity: 0;
    transform: translateY(30px);
    animation: revealUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes revealUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .container {
      padding: 0 40px;
    }

    .projects-hero__grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-stats {
      justify-content: center;
    }

    .category-grid {
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    }

    .projects-masonry {
      grid-template-columns: 1fr;
    }

    .project-large,
    .project-tall {
      grid-column: span 1;
      grid-row: span 1;
    }

    .feature-story__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .hero-visual__wrapper {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 24px;
    }

    .projects-hero {
      padding: 100px 0 60px;
    }

    .projects-hero__title {
      font-size: 2rem;
    }

    .hero-stats {
      flex-direction: column;
      gap: 20px;
      align-items: center;
    }

    .category-grid {
      gap: 12px;
    }

    .category-card {
      padding: 20px 12px;
    }

    .category-icon {
      width: 45px;
      height: 45px;
    }

    .category-icon svg {
      width: 22px;
      height: 22px;
    }

    .category-card h3 {
      font-size: 0.8rem;
    }

    .cta-card {
      padding: 40px 24px;
    }
  }
</style>

<script>
  // Category filtering functionality
  document.querySelectorAll('.category-card').forEach(card => {
    card.addEventListener('click', () => {
      const category = card.getAttribute('data-category');
      
      // Update active state
      document.querySelectorAll('.category-card').forEach(c => c.classList.remove('active'));
      card.classList.add('active');
      
      // Filter projects
      document.querySelectorAll('.project-item').forEach(project => {
        if (category === 'all' || project.getAttribute('data-category') === category) {
          project.style.display = 'block';
        } else {
          project.style.display = 'none';
        }
      });
    });
  });
</script>