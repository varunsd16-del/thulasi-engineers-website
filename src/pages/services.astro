---
import BaseLayout from '../layouts/engineering-authority-layout.astro';
import ContactMini from '../components/features/contact/ContactMini.astro';

// SEO Metadata
const title = "Civil Engineering & Construction Services in Trichy | Thulasi Engineers";
const description = "Explore our comprehensive construction services in Trichy. From residential house construction and commercial buildings to industrial projects and turnkey solutions.";
const keywords = "construction services trichy, civil engineers trichy, building contractors trichy, home builders trichy, renovation services trichy";
---

<BaseLayout title={title} description={description} keywords={keywords} activeNav="services">
  <!-- Cinematic Page Banner -->
  <section class="page-banner">
    <div class="page-banner__bg">
      <img src="/images/localities/civil-engineers-site-inspection-quality-check-trichy.webp" alt="Construction Services in Trichy" class="banner-img" />
      <div class="page-banner__overlay"></div>
    </div>
    <div class="container page-banner__content reveal-up">
      <div class="section-badge">OUR EXPERTISE</div>
      <h1 class="page-banner__title">OUR <span class="text-gold">SERVICES</span></h1>
      <p class="page-banner__subtitle">Comprehensive Engineering & Construction Solutions in Trichy.</p>
      
      <nav class="breadcrumb">
        <a href="/" class="magnetic-elem">Home</a>
        <span class="sep">/</span>
        <span class="current">Services</span>
      </nav>
    </div>

    <!-- Wave Separator -->
    <div class="banner-wave">
      <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M985.66,92.83C906.67,72,823.78,31,743.84,14.19c-82.26-17.34-168.06-16.33-250.45.39-57.84,11.73-114,31.07-172,41.86A600.21,600.21,0,0,1,0,27.35V120H1200V95.8C1132.19,118.92,1055.71,111.31,985.66,92.83Z" class="shape-fill"></path>
      </svg>
    </div>
  </section>

  <!-- Services Grid Section -->
  <section class="services-section">
    <div class="container">
      <div class="services-section__head reveal-up">
        <div class="section-badge">WHAT WE OFFER</div>
        <h2 class="section-title">Comprehensive <span class="text-gold">Engineering</span> Solutions</h2>
        <p class="section-subtitle">From concept to completion, we deliver excellence across every construction discipline.</p>
      </div>

      <div class="services-grid">
        <!-- Building Construction -->
        <div class="service-card reveal-up" style="transition-delay: 0.05s;">
          <div class="service-card__img">
            <img src="/images/services/residential-commercial-building-construction-trichy.webp" alt="Building Construction in Trichy" />
            <div class="service-card__badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
          </div>
          <div class="service-card__body">
            <h3 class="service-card__title">Building Construction</h3>
            <p class="service-card__desc">We deliver high-quality residential, commercial and industrial buildings with precision and excellence.</p>
            <a href="/services/building-construction" class="service-card__link">READ MORE →</a>
          </div>
        </div>

        <!-- Architecture & Planning -->
        <div class="service-card reveal-up" style="transition-delay: 0.1s;">
          <div class="service-card__img">
            <img src="/images/services/3d-architectural-plans-aesthetic-render-trichy.webp" alt="Architecture & Planning Trichy" />
            <div class="service-card__badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l5 5"/></svg>
            </div>
          </div>
          <div class="service-card__body">
            <h3 class="service-card__title">Architecture & Planning</h3>
            <p class="service-card__desc">Creative design and precise planning to turn ideas into functional and sustainable structures.</p>
            <a href="/services/architecture-planning" class="service-card__link">READ MORE →</a>
          </div>
        </div>

        <!-- Project Management Consultant -->
        <div class="service-card reveal-up" style="transition-delay: 0.15s;">
          <div class="service-card__img">
            <img src="/images/services/pmc-project-management-consultants-trichy.webp" alt="Project Management Consultant" />
            <div class="service-card__badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg>
            </div>
          </div>
          <div class="service-card__body">
            <h3 class="service-card__title">Project Management Consultant</h3>
            <p class="service-card__desc">Expert management ensuring timely execution, cost efficiency, BOQ preparation, and quality control.</p>
            <a href="/services/project-management" class="service-card__link">READ MORE →</a>
          </div>
        </div>

        <!-- Renovation & Remodeling -->
        <div class="service-card reveal-up" style="transition-delay: 0.2s;">
          <div class="service-card__img">
            <img src="/images/services/home-renovation-structural-remodeling-trichy.webp" alt="Renovation & Remodeling Services" />
            <div class="service-card__badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
            </div>
          </div>
          <div class="service-card__body">
            <h3 class="service-card__title">Renovation & Remodeling</h3>
            <p class="service-card__desc">Transforming existing spaces with innovative solutions and modern upgrades.</p>
            <a href="/services/renovation-remodeling" class="service-card__link">READ MORE →</a>
          </div>
        </div>

        <!-- Industrial Construction -->
        <div class="service-card reveal-up" style="transition-delay: 0.25s;">
          <div class="service-card__img">
            <img src="/images/services/factory-warehouse-peb-shed-builders-trichy.webp" alt="Industrial Construction Trichy" />
            <div class="service-card__badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            </div>
          </div>
          <div class="service-card__body">
            <h3 class="service-card__title">Industrial Construction</h3>
            <p class="service-card__desc">Specialized in factories, warehouses and industrial facilities built to meet operational demands.</p>
            <a href="/services/industrial-construction" class="service-card__link">READ MORE →</a>
          </div>
        </div>

        <!-- Infrastructure Development -->
        <div class="service-card reveal-up" style="transition-delay: 0.3s;">
          <div class="service-card__img">
            <img src="/images/services/civil-infrastructure-roads-bridges-development-trichy.webp" alt="Infrastructure Development" />
            <div class="service-card__badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
          </div>
          <div class="service-card__body">
            <h3 class="service-card__title">Infrastructure Development</h3>
            <p class="service-card__desc">We build robust infrastructure including roads, bridges, drainage and other essential facilities.</p>
            <a href="/services/infrastructure-development" class="service-card__link">READ MORE →</a>
          </div>
        </div>

        <!-- Safety Management -->
        <div class="service-card reveal-up" style="transition-delay: 0.35s;">
          <div class="service-card__img">
            <img src="/images/services/zero-accident-construction-safety-management-trichy.webp" alt="Construction Safety Management" />
            <div class="service-card__badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
          </div>
          <div class="service-card__body">
            <h3 class="service-card__title">Safety Management</h3>
            <p class="service-card__desc">We prioritize safety at every stage to ensure a secure environment for our people and partners.</p>
            <a href="/services/safety-management" class="service-card__link">READ MORE →</a>
          </div>
        </div>

        <!-- Sustainable Construction -->
        <div class="service-card reveal-up" style="transition-delay: 0.4s;">
          <div class="service-card__img">
            <img src="/images/services/green-building-sustainable-construction-trichy.webp" alt="Sustainable Construction Practices" />
            <div class="service-card__badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
            </div>
          </div>
          <div class="service-card__body">
            <h3 class="service-card__title">Sustainable Construction</h3>
            <p class="service-card__desc">Eco-friendly practices and sustainable materials for a better and greener tomorrow.</p>
            <a href="/services/sustainable-construction" class="service-card__link">READ MORE →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ContactMini />
</BaseLayout>

<style>
  /* CSS Variables */
  :root {
    --navy: #0d1b3e;
    --gold: #c5a059;
    --gold-light: #d4af37;
    --text-dark: #0d1b3e;
    --text-muted: #4b5563;
    --bg-white: #ffffff;
    --border-light: rgba(13, 27, 62, 0.08);
  }

  /* Page Banner */
  .page-banner {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: center;
    background: var(--navy);
    overflow: visible;
    padding-top: 140px;
    padding-bottom: 120px;
    border: none !important;
  }

  .banner-wave {
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    z-index: 5;
  }

  .banner-wave svg {
    position: relative;
    display: block;
    width: calc(100% + 1.3px);
    height: 80px;
    transform: translateY(1px);
  }

  .banner-wave .shape-fill {
    fill: var(--bg-white);
  }

  .page-banner__bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.2;
  }

  .page-banner__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--navy) 0%, rgba(13, 27, 62, 0.85) 50%, rgba(13, 27, 62, 0.7) 100%);
    z-index: 2;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 60px;
    position: relative;
    z-index: 10;
  }

  .page-banner__content {
    max-width: 800px;
  }

  .section-badge {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--gold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 15px;
    display: inline-block;
  }

  .page-banner__title {
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    color: #ffffff;
    margin-bottom: 20px;
  }

  .text-gold {
    color: var(--gold);
  }

  .page-banner__subtitle {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    margin-bottom: 30px;
    max-width: 600px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .breadcrumb a:hover {
    color: var(--gold);
  }

  .breadcrumb .sep {
    color: rgba(255, 255, 255, 0.4);
  }

  .breadcrumb .current {
    color: var(--gold);
  }

  /* Services Section */
  .services-section {
    padding: 100px 0;
    background: var(--bg-white);
  }

  .services-section__head {
    text-align: center;
    margin-bottom: 60px;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--navy);
    margin-bottom: 15px;
    line-height: 1.2;
  }

  .section-subtitle {
    font-size: 1rem;
    color: var(--text-muted);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Services Grid */
  .services-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 30px;
  }

  /* Service Card */
  .service-card {
    flex: 0 1 calc(33.333% - 20px);
    background: var(--bg-white);
    border: 1px solid var(--border-light);
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
  }

  .service-card:hover {
    transform: translateY(-8px);
    border-color: rgba(197, 160, 89, 0.3);
    box-shadow: 0 20px 35px rgba(13, 27, 62, 0.08);
  }

  .service-card__img {
    position: relative;
    height: 220px;
    overflow: hidden;
  }

  .service-card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .service-card:hover .service-card__img img {
    transform: scale(1.05);
  }

  .service-card__badge {
    position: absolute;
    bottom: -18px;
    left: 20px;
    width: 48px;
    height: 48px;
    background: var(--gold);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(197, 160, 89, 0.3);
    z-index: 2;
    transition: all 0.3s ease;
  }

  .service-card:hover .service-card__badge {
    transform: scale(1.05);
    background: var(--gold-light);
  }

  .service-card__badge svg {
    width: 24px;
    height: 24px;
    stroke: #ffffff;
    stroke-width: 2;
  }

  .service-card__body {
    padding: 32px 24px 28px;
    flex: 1;
  }

  .service-card__title {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--navy);
    margin-bottom: 12px;
    letter-spacing: -0.01em;
  }

  .service-card__desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 20px;
  }

  .service-card__link {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--navy);
    text-decoration: none;
    text-transform: uppercase;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .service-card__link:hover {
    color: var(--gold);
    gap: 10px;
  }

  /* Reveal Animation */
  .reveal-up {
    opacity: 0;
    transform: translateY(30px);
    animation: revealUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes revealUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive */
  @media (max-width: 1100px) {
    .service-card {
      flex: 0 1 calc(50% - 15px);
    }
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 40px;
    }

    .services-section {
      padding: 60px 0;
    }

    .services-section__head {
      margin-bottom: 40px;
    }

    .section-title {
      font-size: 1.8rem;
    }

    .section-subtitle {
      font-size: 0.95rem;
    }

    .service-card {
      flex: 0 1 100%;
    }

    .service-card__img {
      height: 200px;
    }

    .page-banner {
      min-height: 40vh;
      padding-top: 120px;
      padding-bottom: 80px;
    }

    .page-banner__title {
      font-size: 2rem;
    }
  }

  @media (max-width: 640px) {
    .container {
      padding: 0 24px;
    }

    .service-card__body {
      padding: 24px 20px;
    }

    .service-card__title {
      font-size: 1rem;
    }
  }

  @media (min-width: 1400px) {
    .container {
      padding: 0 80px;
    }

    .service-card__img {
      height: 250px;
    }

    .service-card__body {
      padding: 32px 28px;
    }
  }
</style>