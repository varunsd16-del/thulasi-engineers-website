---
import BaseLayout from '../layouts/engineering-authority-layout.astro';
---

<BaseLayout title="Why Us — Thulasi Engineers & Contractors" activeNav="why-us">
  
  <!-- ── Cinematic Page Banner ── -->
  <section class="page-banner">
    <div class="page-banner__bg">
      <img src="/images/hero/premium-residential-builders-trichy.webp" alt="Construction site" class="banner-img" />
      <div class="page-banner__overlay"></div>
    </div>
    <div class="container page-banner__content reveal-up">
      <div class="tech-badge">
        <span class="status-dot"></span>
        THE THULASI ADVANTAGE
      </div>
      <h1 class="page-banner__title">WHY <span class="text-accent">US</span></h1>
      <p class="page-banner__subtitle">Engineering Excellence combined with a Client-First approach.</p>
      
      <nav class="breadcrumb">
        <a href="/" class="magnetic-elem" data-cursor="hover">Home</a>
        <span class="sep">/</span>
        <span class="current">Why Us</span>
      </nav>
    </div>

    <!-- Wave Separator -->
    <div class="banner-wave">
      <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M985.66,92.83C906.67,72,823.78,31,743.84,14.19c-82.26-17.34-168.06-16.33-250.45.39-57.84,11.73-114,31.07-172,41.86A600.21,600.21,0,0,1,0,27.35V120H1200V95.8C1132.19,118.92,1055.71,111.31,985.66,92.83Z" class="shape-fill"></path>
      </svg>
    </div>
  </section>

  <!-- ── Advantage Section (Light Spatial UI) ── -->
  <section class="spatial-light-section advantage-section">
    <div class="container relative-z">
      <div class="advantage-section__head reveal-up">
        <div class="tech-badge light-badge">
          <span class="status-dot"></span>
          CORE DIFFERENTIATORS
        </div>
        <h2 class="section-title-light">What Sets <span class="text-accent-light">Us</span> Apart</h2>
        <p class="section-desc-light">We combine engineering mastery, industry experience, and absolute transparency to deliver structural projects that stand the test of time.</p>
      </div>

      <div class="advantage-grid">
        <!-- Card 1: Experience -->
        <div class="advantage-card light-glass-panel reveal-up" style="transition-delay: 0.1s;">
          <div class="advantage-card__icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="7" />
              <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88" />
              <polyline points="9 8 11 10 15 6" />
            </svg>
          </div>
          <h3 class="advantage-card__title">Experience & Expertise</h3>
          <p class="advantage-card__desc">With over 10+ years of industry experience, our lead engineers bring deep architectural knowledge to every project.</p>
          <div class="card-accent-line"></div>
        </div>

        <!-- Card 2: Quality -->
        <div class="advantage-card light-glass-panel reveal-up" style="transition-delay: 0.2s;">
          <div class="advantage-card__icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 18h20" />
              <path d="M12 2v4" />
              <path d="M7 6c0-2.2 1.8-4 4-4s4 1.8 4 4" />
              <path d="M3 10c0-4.4 3.6-8 8-8s8 3.6 8 8" />
              <path d="M5 10v8h14v-8" />
              <path d="M9 14h6" />
            </svg>
          </div>
          <h3 class="advantage-card__title">Quality Workmanship</h3>
          <p class="advantage-card__desc">We adhere to the highest international standards of quality in materials, structural integrity, and finishing.</p>
          <div class="card-accent-line"></div>
        </div>

        <!-- Card 3: Safety -->
        <div class="advantage-card light-glass-panel reveal-up" style="transition-delay: 0.3s;">
          <div class="advantage-card__icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              <polyline points="9 11 11 13 15 9" />
            </svg>
          </div>
          <h3 class="advantage-card__title">Safety First</h3>
          <p class="advantage-card__desc">Safety is our core foundation. We follow strict site protocols to protect our workforce, assets, and the environment.</p>
          <div class="card-accent-line"></div>
        </div>

        <!-- Card 4: Delivery -->
        <div class="advantage-card light-glass-panel reveal-up" style="transition-delay: 0.4s;">
          <div class="advantage-card__icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
              <path d="M2 12h2" />
            </svg>
          </div>
          <h3 class="advantage-card__title">On-Time Delivery</h3>
          <p class="advantage-card__desc">We understand the absolute value of your time and are committed to handing over projects exactly on schedule.</p>
          <div class="card-accent-line"></div>
        </div>

        <!-- Card 5: Satisfaction -->
        <div class="advantage-card light-glass-panel reveal-up" style="transition-delay: 0.5s;">
          <div class="advantage-card__icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
              <circle cx="9" cy="7" r="4" />
              <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
              <path d="M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
          </div>
          <h3 class="advantage-card__title">Client Satisfaction</h3>
          <p class="advantage-card__desc">Our transparent communication and collaborative approach ensure complete alignment at every construction stage.</p>
          <div class="card-accent-line"></div>
        </div>

        <!-- Card 6: Sustainable -->
        <div class="advantage-card light-glass-panel reveal-up" style="transition-delay: 0.6s;">
          <div class="advantage-card__icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 20a7 7 0 0 1-7-7c0-4.5 7-11 7-11s7 6.5 7 11a7 7 0 0 1-7 7z" />
              <path d="M11 20a10 10 0 0 0 10-10" />
              <path d="M11 10s2 2 2 5" />
            </svg>
          </div>
          <h3 class="advantage-card__title">Sustainable Practices</h3>
          <p class="advantage-card__desc">We proudly embrace sustainable, green building methods to construct a better, eco-friendly tomorrow.</p>
          <div class="card-accent-line"></div>
        </div>
      </div>
    </div>
  <!-- ── Lead Engineer's Commitment (Dark Spatial UI) ── -->
  <section class="spatial-section engineer-commitment">
    <div class="container relative-z">
      <div class="commitment-grid">
        <div class="commitment-content reveal-up">
          <div class="tech-badge">
            <span class="status-dot"></span>
            FOUNDER'S VISION
          </div>
          <h2 class="section-title">Built on <span class="text-accent">Structural</span> Integrity</h2>
          <div class="commitment-text">
            <p>"At Thulasi Engineers, we don't just see ourselves as contractors; we are guardians of your architectural dreams. Every structure we engineer in Trichy is a testament to our commitment to structural safety and aesthetic permanence."</p>
            <p>Our philosophy is simple: zero compromise on quality. Whether it's a luxury villa in Srirangam or an industrial complex in Thuvakudi, we apply the same rigorous engineering standards that have made us the most trusted <strong>building contractors in Trichy</strong> for over a decade.</p>
          </div>
          <div class="engineer-meta">
            <div class="eng-signature">Er.Ragavendran Ananda Krishnan</div>
            <div class="eng-designation">Managing Partner</div>
          </div>
        </div>
        <div class="commitment-media reveal-up" style="transition-delay: 0.2s;">
          <div class="media-frame">
             <img src="/images/localities/ongoing-residential-villa-construction-trichy.webp" alt="Er.Ragavendran Ananda Krishnan - Lead Engineer" class="engineer-img" />
             <div class="frame-accent"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── The Engineering Standard (Dark Spatial UI) ── -->
  <section class="spatial-section engineering-standards">
    <div class="container relative-z">
      <div class="section-header text-center reveal-up">
        <div class="tech-badge">
          <span class="status-dot"></span>
          TECHNICAL COMPLIANCE
        </div>
        <h2 class="section-title">The <span class="text-accent">Thulasi</span> Engineering Standard</h2>
        <p class="section-desc">Our construction methodology is rooted in precision, following the strictest national building codes and safety protocols.</p>
      </div>

      <div class="standards-grid">
        <div class="standard-card glass-panel reveal-up" style="transition-delay: 0.1s;">
          <div class="std-num">01</div>
          <h4>ISI Certified Materials</h4>
          <p>Exclusively utilizing high-grade ISI marked steel (TMT 550D) and OPC/PPC 53-grade cement for unmatched structural longevity.</p>
        </div>
        <div class="standard-card glass-panel reveal-up" style="transition-delay: 0.2s;">
          <div class="std-num">02</div>
          <h4>Seismic Resistance</h4>
          <p>Every building is engineered to withstand seismic forces, incorporating advanced earthquake-resistant design principles as per IS 1893:2016.</p>
        </div>
        <div class="standard-card glass-panel reveal-up" style="transition-delay: 0.3s;">
          <div class="std-num">03</div>
          <h4>Soil Analysis Protocol</h4>
          <p>Comprehensive geotechnical investigations performed before foundation design to ensure perfect load distribution and zero settlement issues.</p>
        </div>
        <div class="standard-card glass-panel reveal-up" style="transition-delay: 0.4s;">
          <div class="std-num">04</div>
          <h4>100% Approval Support</h4>
          <p>Seamless navigation through DTCP, LPA, and City Municipal Corporation approvals. We handle the paperwork so you don't have to.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Trichy Authority (Light Spatial UI) ── -->
  <section class="spatial-light-section trichy-authority">
    <div class="container relative-z">
      <div class="authority-grid">
        <div class="authority-media reveal-up">
           <img src="/images/localities/luxury-villa-facade-elevation-design-srirangam.webp" alt="Trichy Skyline Construction" class="trichy-img-light" />
        </div>
        <div class="authority-content reveal-up" style="transition-delay: 0.2s;">
          <div class="tech-badge light-badge">
            <span class="status-dot"></span>
            LOCAL EXPERTISE
          </div>
          <h2 class="section-title-light">Deep Roots in <span class="text-accent-light">Tiruchirappalli</span></h2>
          <p class="section-desc-light" style="text-align: left; margin: 0 0 30px;">As homegrown <strong>civil engineers in Trichy</strong>, we understand the local soil conditions, climate variations, and municipal building laws better than any outsider.</p>
          <ul class="authority-list-light">
             <li><strong>Micro-Local Knowledge:</strong> Optimized designs for the unique architectural heritage of Srirangam and the modern demands of Thillai Nagar.</li>
             <li><strong>Trusted Vendor Network:</strong> Leveraging the best local material suppliers to ensure premium quality at competitive local rates.</li>
             <li><strong>Community Impact:</strong> Having successfully delivered 30+ projects, we are proud contributors to the growing Trichy skyline.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Light Mode Stats Ribbon ── -->
  <section class="spatial-light-section stats-ribbon">
    <div class="container relative-z">
      <div class="stats-ribbon__inner light-glass-panel reveal-up">
        
        <div class="stat-item">
          <div class="stat-icon magnetic-elem">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          </div>
          <div class="stat-content">
            <div class="stat-num">250<span class="text-red">+</span></div>
            <div class="stat-label">PROJECTS COMPLETED</div>
          </div>
        </div>

        <div class="stat-divider"></div>

        <div class="stat-item">
          <div class="stat-icon magnetic-elem">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div class="stat-content">
            <div class="stat-num">200<span class="text-red">+</span></div>
            <div class="stat-label">HAPPY CLIENTS</div>
          </div>
        </div>

        <div class="stat-divider"></div>

        <div class="stat-item">
          <div class="stat-icon magnetic-elem">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.77 3.77z"/></svg>
          </div>
          <div class="stat-content">
            <div class="stat-num">10<span class="text-red">+</span></div>
            <div class="stat-label">YEARS EXPERTISE</div>
          </div>
        </div>

        <div class="stat-divider"></div>

        <div class="stat-item">
          <div class="stat-icon magnetic-elem">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 21h18M5 21V7l8-4v18M13 21V11l8 4v6M8 7h1M8 11h1M8 15h1"/></svg>
          </div>
          <div class="stat-content">
            <div class="stat-num">1.5M<span class="text-red">+</span></div>
            <div class="stat-label">SQ.FT. BUILT</div>
          </div>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Page Banner (Local Override for Wave) ── */
  .page-banner {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: center;
    background: var(--navy);
    overflow: visible;
    padding-top: 140px;
    padding-bottom: 120px;
    border: none !important;
  }

  .banner-wave {
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    z-index: 5;
  }

  .banner-wave svg {
    position: relative;
    display: block;
    width: calc(100% + 1.3px);
    height: 80px;
    transform: translateY(1px);
  }

  .banner-wave .shape-fill {
    fill: var(--bg-white);
  }

  .page-banner__bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .page-banner .banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.25;
  }

  .page-banner__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--navy) 0%, rgba(13, 27, 62, 0.85) 50%, rgba(13, 27, 62, 0.7) 100%);
    z-index: 2;
  }

  .page-banner__title {
    font-size: clamp(3.5rem, 8vw, 5.5rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.1;
    margin-bottom: 24px;
    text-transform: uppercase;
  }

  .page-banner__subtitle {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.8);
    max-width: 650px;
    margin: 0 auto 40px;
    line-height: 1.6;
  }

  .tech-badge.light-badge { border: 1px solid rgba(0, 0, 0, 0.08); background: rgba(0, 0, 0, 0.02); color: #555; }

  /* ── Spatial Environments ── */
  .spatial-section { padding: 120px 0; background: var(--bg-dark, #070709); position: relative; overflow: hidden; }
  .spatial-light-section { padding: 120px 0; position: relative; background: #ffffff; z-index: 2; overflow: hidden; }
  .relative-z { position: relative; z-index: 5; }

  /* ── Typography (Dark Sections) ── */
  .section-title { font-size: clamp(2.5rem, 5vw, 3.8rem); font-weight: 800; color: var(--text-main); margin-bottom: 24px; line-height: 1.1; letter-spacing: -0.02em; text-transform: uppercase; }
  .section-desc { font-size: 1.125rem; color: var(--text-muted); line-height: 1.7; max-width: 650px; margin: 0 auto; }
  .text-accent { color: var(--accent-red); }

  /* ── Advantage Header (Light) ── */
  .advantage-section__head { text-align: center; margin-bottom: 60px; max-width: 800px; margin-left: auto; margin-right: auto; display: flex; flex-direction: column; align-items: center; }
  .section-title-light { font-size: clamp(2.5rem, 4.5vw, 3.5rem); font-weight: 800; color: #070709; margin-bottom: 24px; line-height: 1.1; letter-spacing: -0.02em; }
  .text-accent-light { color: var(--accent-red); position: relative; }
  .text-accent-light::after { content: ''; position: absolute; left: -10px; bottom: 5px; width: calc(100% + 20px); height: 12px; background: var(--accent-red); opacity: 0.15; z-index: -1; border-radius: 10px; }
  .section-desc-light { font-size: 1.125rem; color: #666666; line-height: 1.7; max-width: 650px; }

  /* ── Advantage Cards (Light Glassmorphism) ── */
  .advantage-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; margin-top: 50px; }

  .advantage-card {
    position: relative;
    padding: 40px 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    border-radius: 16px;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease;
    overflow: hidden;
  }

  .light-glass-panel {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(0, 0, 0, 0.05);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.03);
  }

  .advantage-card:hover {
    transform: translateY(-8px);
    border-color: rgba(197, 160, 89, 0.2);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.06);
  }

  .advantage-card__icon-wrap {
    width: 64px; height: 64px;
    background: rgba(197, 160, 89, 0.05);
    border: 1px solid rgba(197, 160, 89, 0.15);
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 24px; color: var(--accent-red);
    transition: all 0.4s ease;
  }

  .advantage-card:hover .advantage-card__icon-wrap {
    background: var(--accent-red);
    color: #fff;
    transform: scale(1.1) rotate(5deg);
    box-shadow: 0 10px 20px rgba(197, 160, 89, 0.2);
  }

  .advantage-card__icon-wrap svg { width: 32px; height: 32px; }

  .advantage-card__title { font-size: 1.25rem; font-weight: 800; color: #070709; margin-bottom: 16px; letter-spacing: -0.01em; }
  .advantage-card__desc { font-size: 0.95rem; color: #666666; line-height: 1.6; margin: 0; }

  .card-accent-line {
    position: absolute; bottom: 0; left: 50%; transform: translateX(-50%);
    width: 0%; height: 3px; background: var(--accent-red);
    transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .advantage-card:hover .card-accent-line { width: 100%; }

  /* ── Lead Engineer Commitment ── */
  .commitment-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 80px; align-items: center; }
  .commitment-text { font-size: 1.15rem; color: var(--text-muted); line-height: 1.8; margin-bottom: 40px; font-style: italic; }
  .commitment-text p { margin-bottom: 20px; }
  .commitment-text strong { color: var(--text-main); }
  
  .engineer-meta { border-left: 2px solid var(--accent-red); padding-left: 24px; }
  .eng-signature { font-family: var(--font-head); font-size: 1.5rem; font-weight: 700; color: var(--text-main); margin-bottom: 4px; }
  .eng-designation { font-size: 0.85rem; color: var(--accent-red); text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600; }

  .media-frame { position: relative; padding: 20px; }
  .engineer-img { width: 100%; height: auto; border-radius: 4px; filter: grayscale(20%) contrast(1.1); position: relative; z-index: 2; }
  .frame-accent { position: absolute; top: 0; left: 0; width: 80%; height: 80%; border: 1px solid var(--accent-red); z-index: 1; opacity: 0.3; }

  /* ── Engineering Standards Grid ── */
  .standards-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 30px; margin-top: 60px; }
  .standard-card { padding: 40px; border-radius: 16px; position: relative; overflow: hidden; transition: transform 0.4s ease, border-color 0.4s ease; }
  .standard-card:hover { transform: translateY(-5px); border-color: rgba(197, 160, 89, 0.3); }
  .std-num { position: absolute; top: 20px; right: 30px; font-size: 4rem; font-weight: 900; color: rgba(255,255,255,0.03); line-height: 1; }
  .standard-card h4 { font-size: 1.25rem; font-weight: 800; color: var(--text-main); margin-bottom: 16px; position: relative; z-index: 2; }
  .standard-card p { font-size: 0.95rem; color: var(--text-muted); line-height: 1.7; margin: 0; position: relative; z-index: 2; }

  .glass-panel {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* ── Trichy Authority (Light) ── */
  .authority-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 80px; align-items: center; }
  .trichy-img-light { width: 100%; height: auto; border-radius: 8px; filter: contrast(1.05); box-shadow: 0 20px 40px rgba(0,0,0,0.08); border: 1px solid rgba(0,0,0,0.05); }
  .authority-list-light { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 18px; }
  .authority-list-light li { position: relative; padding-left: 28px; color: #555; line-height: 1.6; font-size: 0.95rem; }
  .authority-list-light li::before { content: ''; position: absolute; left: 0; top: 10px; width: 12px; height: 2px; background: var(--accent-red); }
  .authority-list-light strong { color: #070709; font-weight: 700; }

  /* ── Stats Ribbon ── */
  .stats-ribbon { padding-top: 0 !important; margin-top: -60px; }
  .stats-ribbon__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 60px 80px;
    border-radius: 24px;
    background: #ffffff;
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.08);
