---
import BaseLayout from '../layouts/engineering-authority-layout.astro';
import ContactMini from '../components/features/contact/ContactMini.astro';
import FAQ from '../components/features/seo/FAQ.astro';
import AreasServed from '../components/features/seo/trichy-locality-showcase.astro';
import AIAgentAnswers from '../components/features/seo/AIAgentAnswers.astro';
import { SITE_METADATA } from '../app/config/site.ts';

const title = `Premium Residential Construction in Trichy | Best House Builders | ${SITE_METADATA.name}`;
const description = SITE_METADATA.description;
const keywords = "residential construction trichy, best builders in trichy, house construction in trichy, villa construction trichy, home builders trichy";
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <!-- Cinematic Page Banner -->
  <section class="page-banner">
    <div class="page-banner__bg">
      <img src="/images/localities/industrial-peb-warehouse-foundation-thuvakudi.webp" alt="Residential Construction in Trichy" class="banner-img" />
      <div class="page-banner__overlay"></div>
    </div>
    <div class="container page-banner__content reveal-up">
      <div class="section-badge">RESIDENTIAL EXPERTS</div>
      <h1 class="page-banner__title">Residential <span class="text-gold">Construction</span> in Trichy</h1>
      <p class="page-banner__subtitle">Your Dream Home, Built by Trichy's Best House Builders.</p>
      
      <nav class="breadcrumb">
        <a href="/" class="magnetic-elem">Home</a>
        <span class="sep">/</span>
        <span class="current">Residential Construction</span>
      </nav>
    </div>

    <!-- Wave Separator -->
    <div class="banner-wave">
      <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M985.66,92.83C906.67,72,823.78,31,743.84,14.19c-82.26-17.34-168.06-16.33-250.45.39-57.84,11.73-114,31.07-172,41.86A600.21,600.21,0,0,1,0,27.35V120H1200V95.8C1132.19,118.92,1055.71,111.31,985.66,92.83Z" class="shape-fill"></path>
      </svg>
    </div>
  </section>

  <section class="service-detail">
    <div class="container">
      <div class="service-detail__grid">
        <div class="service-detail__main">
          <h2 class="reveal-up">Your Dream Home, Built by Trichy's Best House Builders</h2>
          <p class="reveal-up" style="transition-delay: 0.05s;">
            Are you looking for the <strong>best house builders in Trichy</strong> to construct your dream residence? <strong>Thulasi Engineers & Contractors</strong> specializes in creating high-quality, sustainable, and aesthetically pleasing homes that reflect your personality and lifestyle.
          </p>
          
          <p class="reveal-up" style="transition-delay: 0.1s;">
            As leading <strong>residential construction contractors in Trichy</strong>, we understand that building a home is a once-in-a-lifetime investment. That's why we focus on every minute detail, from the strength of the foundation to the elegance of the interior finishes. Our team of <strong>civil engineers</strong> ensures that your home is not just beautiful, but also structurally sound and compliant with all local building codes in Tiruchirappalli.
          </p>

          <img src="/images/localities/commercial-hub-structural-column-casting-trichy.webp" alt="Independent House Construction in Trichy" class="img-fluid rounded my-4 reveal-up" style="transition-delay: 0.15s;" />

          <h3 class="reveal-up" style="transition-delay: 0.2s;">Our Residential Building Expertise</h3>
          <p class="reveal-up" style="transition-delay: 0.25s;">
            We offer a comprehensive range of <strong>home building services in Trichy</strong>, catering to various budgets and architectural styles:
          </p>
          
          <ul class="reveal-up" style="transition-delay: 0.3s;">
            <li><strong>Luxury Villa Construction:</strong> Premium <strong>villa builders in Trichy</strong> offering modern amenities, smart home integrations, and contemporary designs.</li>
            <li><strong>Independent House Construction:</strong> Custom-built homes tailored to your family's needs in localities like Srirangam, KK Nagar, and Thillai Nagar.</li>
            <li><strong>Duplex & Multi-Storey Homes:</strong> Expert engineering for multi-level residential projects with optimized space utilization.</li>
            <li><strong>Low Budget House Construction:</strong> We provide high-quality <strong>low budget house construction in Trichy</strong> using cost-effective materials and smart planning.</li>
          </ul>

          <h3 class="reveal-up" style="transition-delay: 0.35s;">The Thulasi Advantage for Homeowners</h3>
          <p class="reveal-up" style="transition-delay: 0.4s;">
            What sets us apart as the <strong>best construction company for house building in Trichy</strong>?
          </p>
          
          <div class="advantage-grid">
            <div class="adv-item reveal-up" style="transition-delay: 0.45s;">
              <div class="adv-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
              </div>
              <div class="adv-text">
                <h4>Hassle-Free Approvals</h4>
                <p>We handle all the paperwork for house plan approvals from Trichy Corporation and DTCP.</p>
              </div>
            </div>
            <div class="adv-item reveal-up" style="transition-delay: 0.5s;">
              <div class="adv-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              </div>
              <div class="adv-text">
                <h4>Transparency</h4>
                <p>Detailed estimations with no hidden costs. You know exactly what materials we use.</p>
              </div>
            </div>
            <div class="adv-item reveal-up" style="transition-delay: 0.55s;">
              <div class="adv-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </div>
              <div class="adv-text">
                <h4>Superior Quality</h4>
                <p>We use premium brands for cement, steel, and electrical fittings to ensure long-term durability.</p>
              </div>
            </div>
          </div>

          <h3 class="reveal-up" style="transition-delay: 0.6s;">Villa Construction Services in Trichy</h3>
          <p class="reveal-up" style="transition-delay: 0.65s;">
            If you're dreaming of a luxury lifestyle, our <strong>villa construction services in Trichy</strong> are designed for you. We combine modern architecture with traditional values to create spaces that are both grand and comfortable. From private gardens to modular kitchens and luxury bathrooms, we deliver excellence in every corner.
          </p>

          <div class="cta-inner reveal-up" style="transition-delay: 0.7s;">
            <h4>Ready to Build Your Dream Home?</h4>
            <p>Get a personalized quote and architectural consultation from Trichy's top residential builders.</p>
            <a href="/contact" class="btn-gold">START YOUR JOURNEY →</a>
          </div>
        </div>

        <aside class="service-detail__sidebar">
          <div class="sidebar-box reveal-up" style="transition-delay: 0.05s;">
            <h4>Other Services</h4>
            <ul class="sidebar-links">
              <li><a href="/construction-company-trichy">Construction Company Trichy</a></li>
              <li><a href="/commercial-construction-trichy">Commercial Construction</a></li>
              <li><a href="/industrial-construction-trichy">Industrial Construction</a></li>
              <li><a href="/home-renovation-trichy">Renovation Services</a></li>
              <li><a href="/architects-in-trichy">Architects in Trichy</a></li>
            </ul>
          </div>

          <div class="sidebar-box info-box reveal-up" style="transition-delay: 0.1s;">
            <h4>Construction Cost in Trichy</h4>
            <p>Average residential construction cost in Trichy ranges from <strong>₹1,800 to ₹2,500 per sq.ft.</strong></p>
            <a href="/contact" class="sidebar-link">Get Detailed Estimate →</a>
          </div>

          <div class="sidebar-box contact-box reveal-up" style="transition-delay: 0.15s;">
            <h4>Need Expert Advice?</h4>
            <p>Speak directly with our lead civil engineer about your residential project.</p>
            <a href={`tel:${SITE_METADATA.whatsapp.replace('+', '')}`} class="btn-outline-navy full-width">CALL NOW</a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <AreasServed />
  <FAQ />
  <AIAgentAnswers />
  <ContactMini />
</BaseLayout>

<style>
  /* CSS Variables */
  :root {
    --navy: #0d1b3e;
    --gold: #c5a059;
    --gold-light: #d4af37;
    --text-dark: #0d1b3e;
    --text-muted: #4b5563;
    --bg-white: #ffffff;
    --bg-light: #f8fafc;
    --border-light: rgba(13, 27, 62, 0.08);
  }

  /* Page Banner */
  .page-banner {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: center;
    background: var(--navy);
    overflow: visible;
    padding-top: 140px;
    padding-bottom: 120px;
    border: none !important;
  }

  .banner-wave {
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    z-index: 5;
  }

  .banner-wave svg {
    position: relative;
    display: block;
    width: calc(100% + 1.3px);
    height: 80px;
    transform: translateY(1px);
  }

  .banner-wave .shape-fill {
    fill: var(--bg-white);
  }

  .page-banner__bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .page-banner__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.25;
  }

  .page-banner__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--navy) 0%, rgba(13, 27, 62, 0.85) 50%, rgba(13, 27, 62, 0.7) 100%);
    z-index: 2;
  }

  .page-banner__title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    color: #ffffff;
    margin-bottom: 20px;
  }

  .page-banner__subtitle {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    margin-bottom: 30px;
    max-width: 600px;
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }

  .page-banner__content {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 60px;
    position: relative;
    z-index: 10;
  }

  .page-banner__content {
    max-width: 800px;
  }

  .section-badge {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--gold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 15px;
    display: inline-block;
  }

  .page-banner__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.2;
    color: #ffffff;
    margin-bottom: 20px;
  }

  .text-gold {
    color: var(--gold);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .breadcrumb a:hover {
    color: var(--gold);
  }

  .breadcrumb .sep {
    color: rgba(255, 255, 255, 0.4);
  }

  .breadcrumb .current {
    color: var(--gold);
  }

  /* Service Detail */
  .service-detail {
    padding: 80px 0;
    background: var(--bg-white);
  }

  .service-detail__grid {
    display: grid;
    grid-template-columns: 8fr 4fr;
    gap: 60px;
  }

  /* Main Content */
  .service-detail__main h2 {
    font-size: clamp(1.8rem, 3vw, 2.2rem);
    font-weight: 800;
    color: var(--navy);
    margin-bottom: 25px;
    line-height: 1.2;
  }

  .service-detail__main h3 {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--navy);
    margin-top: 40px;
    margin-bottom: 20px;
  }

  .service-detail__main p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-muted);
    margin-bottom: 20px;
  }

  .service-detail__main p strong {
    color: var(--navy);
    font-weight: 700;
  }

  .service-detail__main ul {
    margin-bottom: 30px;
    padding-left: 0;
  }

  .service-detail__main li {
    margin-bottom: 12px;
    font-size: 1rem;
    color: var(--text-muted);
    position: relative;
    list-style: none;
    padding-left: 28px;
  }

  .service-detail__main li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--gold);
    font-weight: 900;
  }

  .img-fluid {
    width: 100%;
    height: auto;
    border-radius: 16px;
    margin: 20px 0;
  }

  /* Advantage Grid */
  .advantage-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin: 40px 0;
  }

  .adv-item {
    display: flex;
    gap: 20px;
    background: var(--bg-light);
    padding: 25px;
    border-radius: 16px;
    transition: all 0.4s ease;
    border: 1px solid var(--border-light);
  }

  .adv-item:hover {
    border-color: rgba(197, 160, 89, 0.3);
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
  }

  .adv-icon {
    width: 50px;
    height: 50px;
    background: rgba(197, 160, 89, 0.1);
    color: var(--gold);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .adv-icon svg {
    width: 26px;
    height: 26px;
    stroke: var(--gold);
  }

  .adv-text h4 {
    font-size: 1rem;
    font-weight: 800;
    color: var(--navy);
    margin-bottom: 8px;
  }

  .adv-text p {
    font-size: 0.9rem;
    margin-bottom: 0;
    color: var(--text-muted);
  }

  /* CTA Inner */
  .cta-inner {
    background: linear-gradient(135deg, var(--navy) 0%, #1a2b5e 100%);
    padding: 45px;
    border-radius: 20px;
    text-align: center;
    margin-top: 50px;
  }

  .cta-inner h4 {
    font-size: 1.5rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 15px;
  }

  .cta-inner p {
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 25px;
  }

  .btn-gold {
    display: inline-block;
    background: var(--gold);
    color: var(--navy);
    padding: 12px 32px;
    font-weight: 700;
    font-size: 0.8rem;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 4px;
    transition: all 0.3s ease;
  }

  .btn-gold:hover {
    background: var(--gold-light);
    transform: translateY(-2px);
  }

  .btn-outline-navy {
    display: inline-block;
    background: transparent;
    color: var(--navy);
    border: 1.5px solid var(--navy);
    padding: 10px 20px;
    font-weight: 700;
    font-size: 0.7rem;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 4px;
    transition: all 0.3s ease;
    text-align: center;
  }

  .btn-outline-navy:hover {
    background: var(--navy);
    color: #ffffff;
  }

  .full-width {
    display: block;
    width: 100%;
  }

  /* Sidebar */
  .service-detail__sidebar {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .sidebar-box {
    background: var(--bg-white);
    padding: 30px;
    border-radius: 16px;
    border: 1px solid var(--border-light);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
  }

  .sidebar-box h4 {
    font-size: 1rem;
    font-weight: 800;
    color: var(--navy);
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--gold);
  }

  .sidebar-links {
    list-style: none;
    padding: 0;
  }

  .sidebar-links li {
    margin-bottom: 12px;
  }

  .sidebar-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s ease;
    display: block;
    padding: 5px 0;
  }

  .sidebar-links a:hover {
    color: var(--gold);
    padding-left: 5px;
  }

  .info-box {
    background: var(--bg-light);
    border-left: 3px solid var(--gold);
  }

  .info-box p {
    font-size: 0.9rem;
    margin-bottom: 20px;
    color: var(--text-muted);
  }

  .info-box p strong {
    color: var(--navy);
  }

  .sidebar-link {
    color: var(--gold);
    font-weight: 700;
    text-decoration: none;
    font-size: 0.85rem;
    transition: all 0.3s ease;
  }

  .sidebar-link:hover {
    color: var(--gold-light);
    transform: translateX(5px);
    display: inline-block;
  }

  .contact-box {
    background: linear-gradient(135deg, var(--bg-light) 0%, #ffffff 100%);
  }

  /* Reveal Animation */
  .reveal-up {
    opacity: 0;
    transform: translateY(30px);
    animation: revealUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes revealUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .container {
      padding: 0 40px;
    }

    .service-detail__grid {
      grid-template-columns: 1fr;
      gap: 50px;
    }

    .page-banner {
      min-height: 40vh;
      padding-top: 120px;
      padding-bottom: 80px;
    }

    .page-banner__title {
      font-size: 2rem;
    }
  }

  @media (max-width: 768px) {
    .service-detail {
      padding: 60px 0;
    }

    .container {
      padding: 0 24px;
    }

    .service-detail__main h2 {
      font-size: 1.6rem;
    }

    .service-detail__main h3 {
      font-size: 1.2rem;
    }

    .service-detail__main p,
    .service-detail__main li {
      font-size: 0.95rem;
    }

    .adv-item {
      padding: 20px;
    }

    .cta-inner {
      padding: 30px 20px;
    }

    .cta-inner h4 {
      font-size: 1.2rem;
    }

    .sidebar-box {
      padding: 25px;
    }
  }

  @media (min-width: 1400px) {
    .container {
      padding: 0 80px;
    }
  }
</style>