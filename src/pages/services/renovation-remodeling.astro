---
import ServiceDetailLayout from '../../layouts/turnkey-service-detail-layout.astro';

const service = {
  title: 'Best Home Renovation & Structural Remodeling in Trichy | Woraiyur & Puthur',
  shortTitle: 'Renovation & Remodeling',
  image: '/images/services/home-renovation-structural-remodeling-trichy.webp',
  description: 'Transform your old property with the best home renovation services in Trichy. Specialists in structural repairs and modern interior upgrades.',
  features: ['Structural Strengthening & Retrofitting', 'Damp-proofing & Leakage Repair', 'Modern Interior Upgrades', 'Kitchen & Bathroom Remodeling', 'Traditional to Modern Transformation'],
  faqs: [
    { q: 'Is it cheaper to renovate or rebuild in Trichy?', a: 'Renovation is often 40-60% cheaper than rebuilding if the core structure is strong. We provide free structural audits to help you decide.' },
    { q: 'How long does a full home renovation take?', a: 'Depending on the scope, a full home renovation in Trichy typically takes 2 to 4 months.' }
  ]
};

const renovationTypes = [
  { title: 'Home Renovations', image: '/images/services/structural-strengthening-old-building-renovations-trichy.webp', desc: 'Complete transformation of old residences into modern, high-functioning homes with premium finishes.' },
  { title: 'Structural Repairs', image: '/images/services/rigorous-structural-concrete-quality-control-testing-trichy.webp', desc: 'Expert strengthening and retrofitting of aging structures to ensure long-term safety and stability.' },
  { title: 'Kitchen & Bathroom Upgrades', image: '/images/services/premium-kitchen-bathroom-remodeling-upgrades-trichy.webp', desc: 'Modernizing essential spaces with contemporary fixtures, tiles, and optimized layouts.' },
  { title: 'Exterior Makeovers', image: '/images/services/exterior-remodeling-facade-structural-makeover-trichy.webp', desc: 'Revitalizing the outer appearance of buildings with modern elevation designs and fresh textures.' },
  { title: 'Waterproofing & Painting', image: '/images/services/damp-proofing-waterproofing-leakage-repair-painting-trichy.webp', desc: 'Professional damp-proofing and premium painting services to protect and beautify your property.' }
];
---

<ServiceDetailLayout service={service}>
  <div class="content-wrapper">
    <div class="section-intro">
      <h2>Expert Renovation & Remodeling Services</h2>
      <p>Preserve the soul of your home while upgrading its comfort. Thulasi Engineers offers the <strong>best home renovation in Trichy</strong>, specializing in transforming traditional houses in areas like <strong>Woraiyur</strong> and <strong>Puthur</strong> into modern masterpieces.</p>
    </div>
    
    <div class="portfolio-section">
      <div class="section-header">
        <div class="section-label">OUR EXPERTISE</div>
        <h3>Our Transformation Solutions</h3>
        <p>We provide comprehensive renovation services to breathe new life into your property:</p>
      </div>

      <div class="construction-grid">
        {renovationTypes.map((type, index) => (
          <div class="construction-card" style={`animation-delay: ${0.1 * index}s`}>
            <div class="card-image">
              <img src={type.image} alt={type.title} loading="lazy" />
              <div class="card-overlay">
                <span class="card-tag">RENOVATE</span>
              </div>
            </div>
            <div class="card-content">
              <h4>{type.title}</h4>
              <p>{type.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="section-why">
      <h3>Structural Repair & Strengthening</h3>
      <p>Renovating old structures in Trichy requires a delicate touch. We provide structural strengthening, damp-proofing, and foundation repairs for aging properties in <strong>Srirangam</strong>, ensuring they remain safe and beautiful for another century.</p>
    </div>
    
    <div class="section-quality">
      <h3>Modern Interior Remodeling</h3>
      <p>From modular kitchen installations to premium bathroom remodeling, we use high-end materials to modernize your living spaces. Our interior designers work with our engineers to ensure that every change is structurally sound and aesthetically pleasing.</p>
    </div>
  </div>
</ServiceDetailLayout>

<style>
  /* Override layout styles for white background aesthetic */
  :global(.service-details) {
    background: #ffffff !important;
    position: relative;
    z-index: 2;
  }

  :global(.details-text) {
    color: #333;
  }

  :global(.details-text h2, .details-text h3, .details-text h4) {
    color: #111 !important;
  }

  :global(.details-sidebar .sidebar-card) {
    border: 1px solid #eee;
    background: #fafafa;
  }

  .content-wrapper {
    display: flex;
    flex-direction: column;
    gap: 60px;
  }

  .section-header {
    margin-bottom: 40px;
  }

  .section-header h3 {
    margin-top: 0 !important;
    font-size: 2.2rem !important;
    margin-bottom: 15px;
  }

  /* Construction Grid */
  .construction-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
    margin-top: 20px;
  }

  .construction-card {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    border: 1px solid #d1d5db;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.8s forwards;
  }

  @keyframes fadeInUp {
    to { opacity: 1; transform: translateY(0); }
  }

  .construction-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    border-color: #9ca3af;
  }

  .card-image {
    position: relative;
    height: 280px;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .construction-card:hover .card-image img {
    transform: scale(1.1);
  }

  .card-overlay {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
  }

  .card-tag {
    background: var(--red);
    color: #fff;
    font-size: 0.6rem;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 1px;
  }

  .card-content {
    padding: 20px;
  }

  .card-content h4 {
    font-size: 1.1rem !important;
    margin-bottom: 10px !important;
    color: #111;
  }

  .card-content p {
    font-size: 0.85rem;
    line-height: 1.5;
    color: #666;
    margin-bottom: 0;
  }

  @media (max-width: 992px) {
    .construction-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    
    .card-image {
      height: 240px;
    }
  }

  @media (max-width: 768px) {
    .section-header h3 {
      font-size: 1.8rem !important;
    }
  }
</style>
