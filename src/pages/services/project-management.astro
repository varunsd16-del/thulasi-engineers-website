---
import ServiceDetailLayout from '../../layouts/turnkey-service-detail-layout.astro';

const service = {
  title: 'Construction Project Management Consultant in Trichy | PMC Services',
  shortTitle: 'Project Management',
  image: '/images/services/pmc-project-management-consultants-trichy.webp',
  description: 'Professional PMC services in Trichy to ensure your construction project is completed on time and within budget with 100% quality assurance.',
  features: ['DTCP & Building Plan Approvals', 'Material Procurement Management', 'Labor Efficiency Optimization', 'Budget Tracking & Reporting', 'Strict Quality Control', 'BOQ & Documentation'],
  faqs: [
    { q: 'What are the benefits of hiring a PMC?', a: 'A PMC helps save 10-15% on construction costs through better procurement and ensures 100% quality compliance.' },
    { q: 'Can you manage projects for NRIs in Trichy?', a: 'Yes, we specialize in managing construction projects for NRI clients, providing daily photo/video updates and transparent reporting.' }
  ]
};

const managementTypes = [
  { title: 'DTCP & Building Approval', image: '/images/services/turnkey-site-supervision-coordination-pmc-trichy.webp', desc: 'Hassle-free legal processing for DTCP, Trichy Corporation, and local body approvals with architectural plan compliance.' },
  { title: 'Quality Control', image: '/images/services/rigorous-structural-concrete-quality-control-testing-trichy.webp', desc: 'Rigorous testing of materials and workmanship to guarantee structural integrity and longevity.' },
  { title: 'Material Procurement', image: '/images/services/transparent-construction-material-procurement-consulting-trichy.webp', desc: 'Strategic sourcing of high-quality construction materials at the most competitive market rates.' },
  { title: 'Budget & Cost Control', image: '/images/services/construction-budget-estimation-cost-control-trichy.webp', desc: 'Meticulous financial management to prevent cost overruns and optimize project expenditure.' },
  { title: 'Timeline Management', image: '/images/services/advanced-construction-scheduling-timeline-management-trichy.webp', desc: 'Detailed scheduling and milestone tracking to ensure timely project delivery.' },
  { title: 'BOQ Prep & Documentation', image: '/images/services/bill-of-quantities-boq-technical-documentation-trichy.webp', desc: 'Precise Bill of Quantities preparation and comprehensive documentation for transparent project execution.' }
];
---

<ServiceDetailLayout service={service}>
  <div class="content-wrapper">
    <div class="section-intro">
      <h2>Professional Project Management Consultancy (PMC)</h2>
      <p>Building a home or office should be a stress-free experience. Our <strong>Project Management Consultancy (PMC) in Trichy</strong> takes the burden off your shoulders, managing every aspect of the construction lifecycle.</p>
    </div>
    
    <div class="portfolio-section">
      <div class="section-header">
        <div class="section-label">OUR EXPERTISE</div>
        <h3>Our Management Solutions</h3>
        <p>We provide end-to-end management services to ensure your project's success:</p>
      </div>

      <div class="construction-grid">
        {managementTypes.map((type, index) => (
          <div class="construction-card" style={`animation-delay: ${0.1 * index}s`}>
            <div class="card-image">
              <img src={type.image} alt={type.title} loading="lazy" />
              <div class="card-overlay">
                <span class="card-tag">MANAGEMENT</span>
              </div>
            </div>
            <div class="card-content">
              <h4>{type.title}</h4>
              <p>{type.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="section-why">
      <h3>Cost Efficiency & Quality Control</h3>
      <p>We act as your on-site advocates, ensuring that materials are sourced at the best prices and that labor productivity is maximized. Our strict quality control protocols ensure that every brick and pillar meets engineering standards.</p>
    </div>
    
    <div class="section-quality">
      <h3>Ideal for NRI Clients</h3>
      <p>We specialize in managing construction for clients who are living abroad or in other cities. Our transparent reporting and digital site updates ensure you are always in the loop.</p>
    </div>
  </div>
</ServiceDetailLayout>

<style>
  /* Override layout styles for white background aesthetic */
  :global(.service-details) {
    background: #ffffff !important;
    position: relative;
    z-index: 2;
  }

  :global(.details-text) {
    color: #333;
  }

  :global(.details-text h2, .details-text h3, .details-text h4) {
    color: #111 !important;
  }

  :global(.details-sidebar .sidebar-card) {
    border: 1px solid #eee;
    background: #fafafa;
  }

  .content-wrapper {
    display: flex;
    flex-direction: column;
    gap: 60px;
  }

  .section-header {
    margin-bottom: 40px;
  }

  .section-header h3 {
    margin-top: 0 !important;
    font-size: 2.2rem !important;
    margin-bottom: 15px;
  }

  /* Construction Grid */
  .construction-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
    margin-top: 20px;
  }

  .construction-card {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    border: 1px solid #d1d5db;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.8s forwards;
  }

  @keyframes fadeInUp {
    to { opacity: 1; transform: translateY(0); }
  }

  .construction-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    border-color: #9ca3af;
  }

  .card-image {
    position: relative;
    height: 280px;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .construction-card:hover .card-image img {
    transform: scale(1.1);
  }

  .card-overlay {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
  }

  .card-tag {
    background: var(--red);
    color: #fff;
    font-size: 0.6rem;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 1px;
  }

  .card-content {
    padding: 20px;
  }

  .card-content h4 {
    font-size: 1.1rem !important;
    margin-bottom: 10px !important;
    color: #111;
  }

  .card-content p {
    font-size: 0.85rem;
    line-height: 1.5;
    color: #666;
    margin-bottom: 0;
  }

  @media (max-width: 992px) {
    .construction-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    
    .card-image {
      height: 240px;
    }
  }

  @media (max-width: 768px) {
    .section-header h3 {
      font-size: 1.8rem !important;
    }
  }
</style>
