---
import ServiceDetailLayout from '../../layouts/turnkey-service-detail-layout.astro';

const service = {
  title: 'Civil Infrastructure Development Company in Trichy | Roads & Bridges',
  shortTitle: 'Infrastructure Development',
  image: '/images/services/residential-villa-building-construction-site-trichy.webp',
  description: 'Building the civil infrastructure of Tiruchirappalli with robust road construction, bridge engineering, and drainage systems.',
  features: ['Asphalt & Concrete Road Construction', 'Urban Drainage Systems', 'Public Utility Infrastructure', 'Earthmoving & Site Development'],
  faqs: [
    { q: 'What types of infrastructure projects do you handle?', a: 'We handle road construction, bridge engineering, storm-water drainage systems, and large-scale land development projects.' },
    { q: 'Do you work with government contracts?', a: 'Yes, we are registered contractors and have the capacity to handle both private and public infrastructure projects in Trichy.' }
  ]
};

const infraTypes = [
  { title: 'Road Construction', image: '/images/services/durable-asphalt-concrete-road-construction-trichy.webp', desc: 'Durable asphalt and concrete road networks designed for heavy traffic and long-term resilience.' },
  { title: 'Bridge Engineering', image: '/images/services/civil-infrastructure-bridge-flyover-engineering-trichy.webp', desc: 'Expertly engineered bridges and culverts connecting communities with safety and precision.' },
  { title: 'Drainage Systems', image: '/images/services/urban-stormwater-drainage-systems-construction-trichy.webp', desc: 'Advanced storm-water and sewage management systems to prevent urban flooding.' },
  { title: 'Site Development', image: '/images/services/large-scale-earthmoving-site-development-grading-trichy.webp', desc: 'Comprehensive land grading, earthmoving, and infrastructure preparation for large-scale layouts.' },
  { title: 'Public Utilities', image: '/images/services/public-utility-infrastructure-contractors-trichy.webp', desc: 'Essential public infrastructure projects including utility ducts and community spaces.' }
];
---

<ServiceDetailLayout service={service}>
  <div class="content-wrapper">
    <div class="section-intro">
      <h2>Large-Scale Infrastructure Development</h2>
      <p>As a leading <strong>infrastructure development company in Trichy</strong>, we are committed to building the backbone of our city. Our civil engineering expertise extends to road networks, drainage systems, and public utility structures across the <strong>Trichy Corporation</strong> limits.</p>
    </div>
    
    <div class="portfolio-section">
      <div class="section-header">
        <div class="section-label">OUR EXPERTISE</div>
        <h3>Our Infrastructure Solutions</h3>
        <p>We build the foundations of a modern city with engineering excellence:</p>
      </div>

      <div class="construction-grid">
        {infraTypes.map((type, index) => (
          <div class="construction-card" style={`animation-delay: ${0.1 * index}s`}>
            <div class="card-image">
              <img src={type.image} alt={type.title} loading="lazy" />
              <div class="card-overlay">
                <span class="card-tag">INFRA</span>
              </div>
            </div>
            <div class="card-content">
              <h4>{type.title}</h4>
              <p>{type.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="section-why">
      <h3>Professional Road & Bridge Construction</h3>
      <p>We use high-grade asphalt and concrete technology to ensure the durability of road networks in rapidly developing areas like <strong>Panjapur</strong> and <strong>Manikandam</strong>. Our bridge engineering team focuses on structural safety and long-term resilience.</p>
    </div>
    
    <div class="section-quality">
      <h3>Urban Drainage & Water Management</h3>
      <p>Effective drainage is critical for urban longevity. We design and implement heavy-duty storm-water drains and sewage networks that can handle peak monsoon loads in the Trichy region.</p>
    </div>
  </div>
</ServiceDetailLayout>

<style>
  /* Override layout styles for white background aesthetic */
  :global(.service-details) {
    background: #ffffff !important;
    position: relative;
    z-index: 2;
  }

  :global(.details-text) {
    color: #333;
  }

  :global(.details-text h2, .details-text h3, .details-text h4) {
    color: #111 !important;
  }

  :global(.details-sidebar .sidebar-card) {
    border: 1px solid #eee;
    background: #fafafa;
  }

  .content-wrapper {
    display: flex;
    flex-direction: column;
    gap: 60px;
  }

  .section-header {
    margin-bottom: 40px;
  }

  .section-header h3 {
    margin-top: 0 !important;
    font-size: 2.2rem !important;
    margin-bottom: 15px;
  }

  /* Construction Grid */
  .construction-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
    margin-top: 20px;
  }

  .construction-card {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    border: 1px solid #d1d5db;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.8s forwards;
  }

  @keyframes fadeInUp {
    to { opacity: 1; transform: translateY(0); }
  }

  .construction-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    border-color: #9ca3af;
  }

  .card-image {
    position: relative;
    height: 280px;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .construction-card:hover .card-image img {
    transform: scale(1.1);
  }

  .card-overlay {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
  }

  .card-tag {
    background: var(--red);
    color: #fff;
    font-size: 0.6rem;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 1px;
  }

  .card-content {
    padding: 20px;
  }

  .card-content h4 {
    font-size: 1.1rem !important;
    margin-bottom: 10px !important;
    color: #111;
  }

  .card-content p {
    font-size: 0.85rem;
    line-height: 1.5;
    color: #666;
    margin-bottom: 0;
  }

  @media (max-width: 992px) {
    .construction-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    
    .card-image {
      height: 240px;
    }
  }

  @media (max-width: 768px) {
    .section-header h3 {
      font-size: 1.8rem !important;
    }
  }
</style>
