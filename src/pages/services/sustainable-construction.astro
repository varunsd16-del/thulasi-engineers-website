---
import ServiceDetailLayout from '../../layouts/turnkey-service-detail-layout.astro';

const service = {
  title: 'Sustainable Construction & Green Building Builders in Trichy',
  shortTitle: 'Sustainable Construction',
  image: '/images/services/green-building-sustainable-construction-trichy.webp',
  description: 'Build for the future with the best sustainable construction company in Trichy. Solar integration, rainwater harvesting, and eco-friendly materials.',
  features: ['Energy-Efficient Building Design', 'Rainwater Harvesting Systems', 'Solar Power Integration', 'Eco-friendly Material Sourcing', 'LEED-Standard Consulting'],
  faqs: [
    { q: 'What is a green building?', a: 'A green building uses less water, energy, and natural resources while creating less waste and providing a healthier living environment.' },
    { q: 'Does sustainable construction cost more?', a: 'The initial investment may be 5-8% higher, but you recover the cost within 3-5 years through significant energy and water savings.' }
  ]
};

const sustainableTypes = [
  { title: 'Green Buildings', image: '/images/services/leed-standard-green-building-consultants-trichy.webp', desc: 'Environmentally responsible structures designed for maximum energy efficiency and resource conservation.' },
  { title: 'Solar Integration', image: '/images/services/energy-efficient-solar-power-panel-integration-trichy.webp', desc: 'Seamless integration of solar photovoltaic systems to power your home with clean, renewable energy.' },
  { title: 'Rainwater Harvesting', image: '/images/services/smart-residential-rainwater-harvesting-systems-trichy.webp', desc: 'Advanced water collection and filtration systems to ensure sustainable water management for your property.' },
  { title: 'Eco-friendly Materials', image: '/images/services/eco-friendly-aac-block-sustainable-materials-trichy.webp', desc: 'Utilization of sustainable materials like AAC blocks and fly-ash bricks to reduce environmental impact.' },
  { title: 'Energy-Efficient Design', image: '/images/services/natural-cooling-aac-block-energy-efficient-design-trichy.webp', desc: 'Architectural planning focused on natural lighting and cross-ventilation to minimize energy usage.' }
];
---

<ServiceDetailLayout service={service}>
  <div class="content-wrapper">
    <div class="section-intro">
      <h2>Eco-Friendly & Sustainable Construction</h2>
      <p>The future of construction is green. Thulasi Engineers is a pioneer in <strong>sustainable construction in Trichy</strong>, helping clients build energy-efficient and eco-friendly homes and offices.</p>
    </div>
    
    <div class="portfolio-section">
      <div class="section-header">
        <div class="section-label">OUR EXPERTISE</div>
        <h3>Our Sustainable Solutions</h3>
        <p>We build for the future with eco-conscious engineering and design:</p>
      </div>

      <div class="construction-grid">
        {sustainableTypes.map((type, index) => (
          <div class="construction-card" style={`animation-delay: ${0.1 * index}s`}>
            <div class="card-image">
              <img src={type.image} alt={type.title} loading="lazy" />
              <div class="card-overlay">
                <span class="card-tag">GREEN</span>
              </div>
            </div>
            <div class="card-content">
              <h4>{type.title}</h4>
              <p>{type.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="section-why">
      <h3>Eco-Friendly Building Materials</h3>
      <p>We specialize in using AAC blocks, fly-ash bricks, and low-VOC paints to reduce the environmental footprint of your building. Our sustainable projects in <strong>KK Nagar</strong> and <strong>Srirangam</strong> are designed to stay cool naturally, reducing air conditioning costs.</p>
    </div>
    
    <div class="section-quality">
      <h3>Smart Resource Management</h3>
      <p>Every sustainable home we build in Trichy includes advanced rainwater harvesting systems and solar energy integration as standard options, ensuring long-term resource independence.</p>
    </div>
  </div>
</ServiceDetailLayout>

<style>
  /* Override layout styles for white background aesthetic */
  :global(.service-details) {
    background: #ffffff !important;
    position: relative;
    z-index: 2;
  }

  :global(.details-text) {
    color: #333;
  }

  :global(.details-text h2, .details-text h3, .details-text h4) {
    color: #111 !important;
  }

  :global(.details-sidebar .sidebar-card) {
    border: 1px solid #eee;
    background: #fafafa;
  }

  .content-wrapper {
    display: flex;
    flex-direction: column;
    gap: 60px;
  }

  .section-header {
    margin-bottom: 40px;
  }

  .section-header h3 {
    margin-top: 0 !important;
    font-size: 2.2rem !important;
    margin-bottom: 15px;
  }

  /* Construction Grid */
  .construction-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
    margin-top: 20px;
  }

  .construction-card {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    border: 1px solid #d1d5db;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.8s forwards;
  }

  @keyframes fadeInUp {
    to { opacity: 1; transform: translateY(0); }
  }

  .construction-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    border-color: #9ca3af;
  }

  .card-image {
    position: relative;
    height: 280px;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .construction-card:hover .card-image img {
    transform: scale(1.1);
  }

  .card-overlay {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
  }

  .card-tag {
    background: var(--red);
    color: #fff;
    font-size: 0.6rem;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 1px;
  }

  .card-content {
    padding: 20px;
  }

  .card-content h4 {
    font-size: 1.1rem !important;
    margin-bottom: 10px !important;
    color: #111;
  }

  .card-content p {
    font-size: 0.85rem;
    line-height: 1.5;
    color: #666;
    margin-bottom: 0;
  }

  @media (max-width: 992px) {
    .construction-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    
    .card-image {
      height: 240px;
    }
  }

  @media (max-width: 768px) {
    .section-header h3 {
      font-size: 1.8rem !important;
    }
  }
</style>
