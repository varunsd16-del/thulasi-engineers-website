---
import BaseLayout from '../layouts/engineering-authority-layout.astro';
import FAQ from '../components/features/seo/FAQ.astro';
import { SITE_METADATA } from '../app/config/site.ts';

// SEO Metadata for Contact Page
const pageTitle = `Contact Best Building Contractors in Trichy | ${SITE_METADATA.name}`;
const pageDescription = SITE_METADATA.description;
const pageKeywords = "building contractors in trichy, construction company contact trichy, civil engineers trichy phone number, construction estimation trichy";
---

<BaseLayout title={pageTitle} description={pageDescription} keywords={pageKeywords} activeNav="contact">
  <!-- Cinematic Page Banner -->
  <section class="page-banner">
    <div class="page-banner__bg">
      <img src="/images/localities/urban-roads-asphalt-laying-machinery-trichy.webp" alt="Contact Thulasi Engineers - Construction Company in Trichy" class="banner-img" />
      <div class="page-banner__overlay"></div>
    </div>
    <div class="container page-banner__content reveal-up">
      <div class="section-badge">GET IN TOUCH</div>
      <h1 class="page-banner__title">CONTACT <span class="text-gold">OUR EXPERTS</span></h1>
      <p class="page-banner__subtitle">Get a Free Consultation and Detailed Project Estimation Today.</p>
      
      <nav class="breadcrumb">
        <a href="/" class="magnetic-elem">Home</a>
        <span class="sep">/</span>
        <span class="current">Contact Us</span>
      </nav>
    </div>

    <!-- Wave Separator -->
    <div class="banner-wave">
      <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M985.66,92.83C906.67,72,823.78,31,743.84,14.19c-82.26-17.34-168.06-16.33-250.45.39-57.84,11.73-114,31.07-172,41.86A600.21,600.21,0,0,1,0,27.35V120H1200V95.8C1132.19,118.92,1055.71,111.31,985.66,92.83Z" class="shape-fill"></path>
      </svg>
    </div>
  </section>

  <!-- Main Contact Section -->
  <section class="contact-page">
    <div class="container">
      <div class="contact-grid">
        
        <!-- Column 1: Info -->
        <div class="contact-info-col">
          <div class="section-badge">GET IN TOUCH</div>
          <h2 class="contact-main-heading">Let's Build Your Dream Project in <span class="text-gold">Trichy</span></h2>
          <p class="contact-description">
            Whether you are looking for residential house construction, commercial building services, or industrial engineering in Trichy, our experts are here to help.
          </p>

          <div class="info-list">
            <a href="https://maps.google.com" target="_blank" rel="noopener noreferrer" class="info-item">
              <div class="info-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <strong>HEAD OFFICE</strong>
                <p>{SITE_METADATA.address.street},<br/>{SITE_METADATA.address.city} - {SITE_METADATA.address.zip}</p>
              </div>
            </a>

            <a href={`tel:${SITE_METADATA.whatsapp.replace('+', '')}`} class="info-item">
              <div class="info-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l2.28-2.28a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              <div>
                <strong>CALL US</strong>
                <p>{SITE_METADATA.phone}</p>
              </div>
            </a>

            <a href={`mailto:${SITE_METADATA.email}`} class="info-item">
              <div class="info-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <div>
                <strong>EMAIL US</strong>
                <p>{SITE_METADATA.email}</p>
              </div>
            </a>
          </div>

          <div class="social-links-contact">
            <span>FOLLOW OUR WORK:</span>
            <a href={SITE_METADATA.social.facebook} aria-label="Facebook" class="social-contact-link">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
            <a href={SITE_METADATA.social.instagram} aria-label="Instagram" class="social-contact-link">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="4"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
            <a href={SITE_METADATA.social.whatsapp} aria-label="WhatsApp" class="social-contact-link">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l2.27-2.28a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </a>
          </div>
        </div>

        <!-- Column 2: Form -->
        <div class="contact-form-card">
          <h3 class="form-title">Request a Free Estimation</h3>
          <p class="form-sub">Fill out the form below and our engineers will contact you within 24 hours.</p>
          <form class="actual-form">
            <div class="form-row">
              <input type="text" placeholder="Your Name *" required />
              <input type="email" placeholder="Email Address *" required />
            </div>
            <div class="form-row">
              <input type="tel" placeholder="Mobile Number *" required />
              <select required>
                <option value="" disabled selected>Project Location</option>
                <option>Trichy City</option>
                <option>Srirangam</option>
                <option>Thillai Nagar</option>
                <option>KK Nagar</option>
                <option>Other Trichy Area</option>
              </select>
            </div>
            <textarea placeholder="Tell us about your project requirements (e.g., 3BHK Villa, Office Interior, etc.) *" rows="5" required></textarea>
            <button type="submit" class="btn-gold">
              SEND INQUIRY NOW →
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Map Section -->
  <section class="map-full">
    <div class="container">
      <div class="map-wrapper">
        <iframe 
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3918.4239857907575!2d78.7118243!3d10.8553254!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMTDCsDUxJzE5LjIiTiA3OMKwNDInNDIuNiJF!5e0!3m2!1sen!2sin!4v1715241600000!5m2!1sen!2sin" 
          width="100%" 
          height="400" 
          style="border:0;" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </div>
  </section>

  <FAQ />

  <!-- Bottom CTA -->
  <section class="bottom-cta">
    <div class="container">
      <div class="cta-inner">
        <div class="cta-text">
          <h3>READY TO START YOUR PROJECT?</h3>
          <p>Let's turn your vision into reality with our expertise and commitment to quality construction.</p>
        </div>
        <a href="#" class="btn-gold cta-quote">
          GET A QUOTE TODAY →
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Page Banner */
  .page-banner {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: center;
    background: var(--navy);
    overflow: visible;
    padding-top: 140px;
    padding-bottom: 120px;
    border: none !important;
  }

  .banner-wave {
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    z-index: 5;
  }

  .banner-wave svg {
    position: relative;
    display: block;
    width: calc(100% + 1.3px);
    height: 80px;
    transform: translateY(1px);
  }

  .banner-wave .shape-fill {
    fill: var(--bg-white);
  }

  .page-banner__bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.2;
  }

  .page-banner__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #0d1b3e 0%, rgba(13, 27, 62, 0.85) 50%, rgba(13, 27, 62, 0.7) 100%);
    z-index: 2;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 60px;
    position: relative;
    z-index: 10;
  }

  .page-banner__content {
    max-width: 800px;
  }

  .section-badge {
    font-size: 0.7rem;
    font-weight: 700;
    color: #c5a059;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 15px;
    display: inline-block;
  }

  .page-banner__title {
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    color: #ffffff;
    margin-bottom: 20px;
  }

  .text-gold {
    color: #c5a059;
  }

  .page-banner__subtitle {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    margin-bottom: 30px;
    max-width: 600px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .breadcrumb a:hover {
    color: #c5a059;
  }

  .breadcrumb .sep {
    color: rgba(255, 255, 255, 0.4);
  }

  .breadcrumb .current {
    color: #c5a059;
  }

  /* Contact Page */
  .contact-page {
    padding: 100px 0;
    background: #ffffff;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 80px;
    align-items: start;
  }

  .contact-main-heading {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 800;
    color: #0d1b3e;
    line-height: 1.2;
    margin-bottom: 20px;
  }

  .contact-main-heading span {
    color: #c5a059;
  }

  .contact-description {
    font-size: 1rem;
    color: #4b5563;
    line-height: 1.7;
    margin-bottom: 40px;
  }

  /* Info List */
  .info-list {
    display: flex;
    flex-direction: column;
    gap: 30px;
    margin-bottom: 40px;
  }

  .info-item {
    display: flex;
    gap: 20px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .info-item:hover {
    transform: translateX(8px);
  }

  .info-icon {
    width: 50px;
    height: 50px;
    background: rgba(197, 160, 89, 0.1);
    color: #c5a059;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.3s ease;
  }

  .info-item:hover .info-icon {
    background: #c5a059;
    color: #ffffff;
  }

  .info-icon svg {
    width: 24px;
    height: 24px;
  }

  .info-item strong {
    display: block;
    font-size: 0.7rem;
    color: #6b7280;
    letter-spacing: 0.1em;
    margin-bottom: 5px;
    text-transform: uppercase;
  }

  .info-item p {
    font-size: 1rem;
    color: #0d1b3e;
    font-weight: 600;
    line-height: 1.4;
    margin: 0;
  }

  /* Social Links */
  .social-links-contact {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-top: 30px;
    border-top: 1px solid rgba(13, 27, 62, 0.08);
  }

  .social-links-contact span {
    font-size: 0.75rem;
    font-weight: 700;
    color: #0d1b3e;
    letter-spacing: 0.1em;
  }

  .social-contact-link {
    width: 38px;
    height: 38px;
    background: rgba(197, 160, 89, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #0d1b3e;
    transition: all 0.3s ease;
  }

  .social-contact-link:hover {
    background: #c5a059;
    color: #ffffff;
    transform: translateY(-3px);
  }

  /* Form Card */
  .contact-form-card {
    background: #ffffff;
    padding: 50px;
    border-radius: 20px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(13, 27, 62, 0.08);
  }

  .form-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: #0d1b3e;
    margin-bottom: 10px;
  }

  .form-sub {
    font-size: 0.9rem;
    color: #4b5563;
    margin-bottom: 30px;
  }

  .actual-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .actual-form input,
  .actual-form select,
  .actual-form textarea {
    width: 100%;
    padding: 14px 18px;
    border: 1.5px solid rgba(13, 27, 62, 0.1);
    border-radius: 8px;
    font-family: inherit;
    font-size: 0.9rem;
    transition: all 0.3s ease;
    background: #ffffff;
  }

  .actual-form input:focus,
  .actual-form select:focus,
  .actual-form textarea:focus {
    outline: none;
    border-color: #c5a059;
    box-shadow: 0 0 0 3px rgba(197, 160, 89, 0.1);
  }

  .btn-gold {
    background: #c5a059;
    color: #0d1b3e;
    border: none;
    padding: 14px 28px;
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .btn-gold:hover {
    background: #d4af37;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(197, 160, 89, 0.3);
  }

  /* Map Section */
  .map-full {
    padding-bottom: 100px;
    background: #ffffff;
  }

  .map-wrapper {
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(13, 27, 62, 0.08);
  }

  /* Bottom CTA */
  .bottom-cta {
    padding: 80px 0 100px 0;
    background: #ffffff;
  }

  .cta-inner {
    background: linear-gradient(135deg, #0d1b3e 0%, #1a2b5e 100%);
    border-radius: 20px;
    padding: 50px 60px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 40px;
    position: relative;
    overflow: hidden;
  }

  .cta-inner::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(197, 160, 89, 0.1) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-text {
    position: relative;
    z-index: 1;
  }

  .cta-text h3 {
    font-size: 1.5rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 8px;
  }

  .cta-text p {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .cta-quote {
    display: inline-block;
    text-decoration: none;
    white-space: nowrap;
  }

  /* Reveal Animation */
  .reveal-up {
    opacity: 0;
    transform: translateY(30px);
    animation: revealUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes revealUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .container {
      padding: 0 40px;
    }

    .contact-grid {
      grid-template-columns: 1fr;
      gap: 60px;
    }

    .contact-form-card {
      padding: 40px;
    }

    .cta-inner {
      flex-direction: column;
      text-align: center;
      padding: 40px;
    }

    .cta-quote {
      white-space: normal;
    }
  }

  @media (max-width: 768px) {
    .contact-page {
      padding: 60px 0;
    }

    .map-full {
      padding-bottom: 60px;
    }

    .bottom-cta {
      padding: 40px 0 60px 0;
    }

    .form-row {
      grid-template-columns: 1fr;
      gap: 15px;
    }

    .contact-form-card {
      padding: 30px;
    }

    .cta-inner {
      padding: 30px 24px;
    }

    .cta-text h3 {
      font-size: 1.2rem;
    }
  }

  @media (max-width: 640px) {
    .container {
      padding: 0 24px;
    }

    .page-banner {
      min-height: 40vh;
      padding-top: 120px;
      padding-bottom: 80px;
    }

    .page-banner__title {
      font-size: 2rem;
    }

    .page-banner__subtitle {
      font-size: 0.95rem;
    }

    .contact-main-heading {
      font-size: 1.6rem;
    }

    .contact-description {
      font-size: 0.95rem;
    }

    .info-item {
      gap: 15px;
    }

    .info-icon {
      width: 45px;
      height: 45px;
    }

    .info-icon svg {
      width: 20px;
      height: 20px;
    }

    .form-title {
      font-size: 1.4rem;
    }
  }

  @media (min-width: 1400px) {
    .container {
      padding: 0 80px;
    }

    .contact-main-heading {
      font-size: 2.8rem;
    }
  }
</style>