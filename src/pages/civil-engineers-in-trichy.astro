---
import BaseLayout from '../layouts/engineering-authority-layout.astro';
import ContactMini from '../components/features/contact/ContactMini.astro';
import FAQ from '../components/features/seo/FAQ.astro';
import AreasServed from '../components/features/seo/trichy-locality-showcase.astro';
import AIAgentAnswers from '../components/features/seo/AIAgentAnswers.astro';
import { SITE_METADATA } from '../app/config/site.ts';

const title = `Registered Civil Engineers in Trichy | Expert Structural Engineering | ${SITE_METADATA.name}`;
const description = SITE_METADATA.description;
const keywords = "civil engineers in trichy, structural engineers trichy, civil engineering trichy, construction consultants trichy, best engineers in trichy";
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <!-- Cinematic Page Banner -->
  <section class="page-banner">
    <div class="page-banner__bg">
      <img src="/images/localities/independent-villa-elevation-design-srirangam.webp" alt="Civil Engineers in Trichy" class="banner-img" />
      <div class="page-banner__overlay"></div>
    </div>
    <div class="container page-banner__content reveal-up">
      <div class="section-badge">ENGINEERING EXPERTS</div>
      <h1 class="page-banner__title">Civil <span class="text-gold">Engineers</span> in Trichy</h1>
      <p class="page-banner__subtitle">Structural strength and architectural precision for any building project.</p>
      
      <nav class="breadcrumb">
        <a href="/" class="magnetic-elem">Home</a>
        <span class="sep">/</span>
        <span class="current">Civil Engineers Trichy</span>
      </nav>
    </div>

    <!-- Wave Separator -->
    <div class="banner-wave">
      <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M985.66,92.83C906.67,72,823.78,31,743.84,14.19c-82.26-17.34-168.06-16.33-250.45.39-57.84,11.73-114,31.07-172,41.86A600.21,600.21,0,0,1,0,27.35V120H1200V95.8C1132.19,118.92,1055.71,111.31,985.66,92.83Z" class="shape-fill"></path>
      </svg>
    </div>
  </section>

  <section class="service-detail">
    <div class="container">
      <div class="service-detail__grid">
        <div class="service-detail__main">
          <h2>Professional Civil Engineering & Consultancy Services in Trichy</h2>
          <p>
            Structural strength and architectural precision are the foundations of any great building. At <strong>Thulasi Engineers & Contractors</strong>, our team of highly qualified <strong>civil engineers in Trichy</strong> provides expert consultancy and engineering services for residential, commercial, and industrial projects across Tiruchirappalli.
          </p>
          
          <p>
            Whether you need a <strong>structural design</strong> for a multi-storey building or assistance with <strong>house plan approvals in Trichy</strong>, our registered engineers offer professional guidance at every step. We combine years of technical expertise with modern technology to deliver projects that are safe, efficient, and sustainable.
          </p>

          <img src="/images/localities/civil-engineers-site-inspection-quality-check-trichy.webp" alt="Civil Engineering Consultancy in Trichy" class="img-fluid rounded my-4" />

          <h3>Our Civil Engineering Capabilities</h3>
          <p>
            As a leading <strong>civil engineering firm in Trichy</strong>, we offer specialized services that go beyond simple construction:
          </p>
          
          <ul>
            <li><strong>Structural Design & Analysis:</strong> Expert <strong>structural engineers in Trichy</strong> providing stable and cost-effective designs for buildings of all scales.</li>
            <li><strong>House Plan & DTCP Approvals:</strong> Complete consultancy for obtaining building permits and plan approvals from Trichy Corporation.</li>
            <li><strong>2D & 3D Architectural Planning:</strong> Modern house designs and floor plans that maximize space and comply with Vaastu and local regulations.</li>
            <li><strong>Construction Project Management:</strong> Professional site engineering and supervision to ensure quality control and safety on-site.</li>
            <li><strong>Estimation & Valuation:</strong> Detailed <strong>construction estimation in Trichy</strong> for bank loans and budget planning.</li>
          </ul>

          <h3>The Role of a Site Engineer in Your Project</h3>
          <p>
            One of the key reasons why we are considered the <strong>best civil contractors in Trichy</strong> is our focus on on-site management. Our <strong>site engineers in Trichy</strong> are present during all critical phases—foundation laying, concrete pouring, and structural assembly—to ensure that the actual construction matches the engineering drawings exactly. This prevents costly errors and ensures the safety of your investment.
          </p>

          <div class="service-stats">
            <div class="stat-box">
              <strong>15+</strong>
              <span>Registered Engineers</span>
            </div>
            <div class="stat-box">
              <strong>100%</strong>
              <span>Approval Success</span>
            </div>
            <div class="stat-box">
              <strong>0</strong>
              <span>Structural Failures</span>
            </div>
          </div>

          <h3>Construction Consultants You Can Trust</h3>
          <p>
            If you are planning to build but aren't sure where to start, our <strong>construction consultants in Trichy</strong> can help. We provide feasibility studies, soil testing analysis, and material selection guidance. Our goal is to make the engineering aspect of construction simple and transparent for our clients.
          </p>

          <div class="cta-inner">
            <h4>Consult with an Expert Civil Engineer</h4>
            <p>Book a free 30-minute consultancy session for your upcoming project in Trichy.</p>
            <a href="/contact" class="btn btn--red">BOOK CONSULTATION</a>
          </div>
        </div>

        <aside class="service-detail__sidebar">
          <div class="sidebar-box">
            <h4>Engineering Services</h4>
            <ul class="sidebar-links">
              <li><a href="/structural-design-trichy">Structural Design Trichy</a></li>
              <li><a href="/2d-3d-house-plan-trichy">2D & 3D House Plans</a></li>
              <li><a href="/construction-estimation-trichy">Project Estimation</a></li>
              <li><a href="/site-engineers-trichy">Site Engineering</a></li>
              <li><a href="/construction-consultants-trichy">Construction Consultancy</a></li>
            </ul>
          </div>

          <div class="sidebar-box trust-box">
            <h4>Professional Ethics</h4>
            <p>Our engineers are members of the <strong>Institution of Engineers (India)</strong> and adhere to strict ethical standards.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <AreasServed />
  <FAQ />
  <AIAgentAnswers />
  <ContactMini />
</BaseLayout>

<style>
  /* Page Banner */
  .page-banner {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: center;
    background: var(--navy);
    overflow: visible;
    padding-top: 140px;
    padding-bottom: 120px;
    border: none !important;
  }

  .banner-wave {
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    z-index: 5;
  }

  .banner-wave svg {
    position: relative;
    display: block;
    width: calc(100% + 1.3px);
    height: 80px;
    transform: translateY(1px);
  }

  .banner-wave .shape-fill {
    fill: var(--bg-white);
  }

  .page-banner__bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.25;
  }

  .page-banner__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--navy) 0%, rgba(13, 27, 62, 0.85) 50%, rgba(13, 27, 62, 0.7) 100%);
    z-index: 2;
  }

  .page-banner__title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    color: #ffffff;
    margin-bottom: 20px;
  }

  .page-banner__title span {
    color: var(--gold);
  }

  .text-gold {
    color: var(--gold);
  }

  .page-banner__subtitle {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    margin-bottom: 30px;
    max-width: 600px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .breadcrumb a:hover {
    color: var(--gold);
  }

  .breadcrumb .sep {
    color: rgba(255, 255, 255, 0.4);
  }

  .breadcrumb .current {
    color: var(--gold);
  }

  .section-badge {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--gold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 15px;
    display: inline-block;
  }

  .reveal-up {
    opacity: 0;
    transform: translateY(30px);
    animation: revealUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes revealUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .service-detail { padding: 100px 0; }
  .service-detail__grid { display: grid; grid-template-columns: 8fr 4fr; gap: 60px; }
  
  .service-detail__main h2 { font-family: var(--font-head); font-size: 2.2rem; font-weight: 800; margin-bottom: 25px; color: var(--black); }
  .service-detail__main h3 { font-family: var(--font-head); font-size: 1.6rem; font-weight: 700; margin-top: 40px; margin-bottom: 20px; color: var(--black); }
  .service-detail__main p { font-size: 1.1rem; line-height: 1.8; color: var(--text-body); margin-bottom: 20px; }
  .service-detail__main ul { margin-bottom: 30px; padding-left: 20px; }
  .service-detail__main li { margin-bottom: 12px; font-size: 1.05rem; color: var(--text-body); position: relative; list-style: none; padding-left: 25px; }
  .service-detail__main li::before { content: '✓'; position: absolute; left: 0; color: var(--red); font-weight: 900; }

  .service-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin: 40px 0; }
  .stat-box { background: #f8f9fa; padding: 25px; border-radius: 15px; text-align: center; border-bottom: 4px solid var(--red); }
  .stat-box strong { display: block; font-family: var(--font-head); font-size: 1.8rem; font-weight: 800; color: var(--red); margin-bottom: 5px; }
  .stat-box span { font-size: 0.8rem; font-weight: 700; color: var(--gray-mid); text-transform: uppercase; letter-spacing: 0.05em; }

  .cta-inner { background: var(--black); color: #fff; padding: 50px; border-radius: 20px; text-align: center; margin-top: 60px; }
  .cta-inner h4 { font-family: var(--font-head); font-size: 1.8rem; margin-bottom: 15px; }
  .cta-inner p { opacity: 0.8; margin-bottom: 30px; }

  /* Sidebar */
  .sidebar-box { background: #fff; padding: 35px; border-radius: 20px; border: 1px solid var(--gray-border); margin-bottom: 30px; box-shadow: var(--shadow-sm); }
  .sidebar-box h4 { font-family: var(--font-head); font-size: 1.2rem; font-weight: 800; margin-bottom: 25px; padding-bottom: 15px; border-bottom: 2px solid var(--red); }
  .sidebar-links { list-style: none; padding: 0; }
  .sidebar-links li { margin-bottom: 15px; }
  .sidebar-links a { color: var(--text-body); font-weight: 600; transition: color 0.2s; }
  .sidebar-links a:hover { color: var(--red); }

  .trust-box { border-left: 4px solid #22c55e; }
  .trust-box p { font-size: 0.95rem; margin-bottom: 0; font-style: italic; }

  @media (max-width: 1024px) {
    .service-detail__grid { grid-template-columns: 1fr; }
    .service-stats { grid-template-columns: 1fr; }
    .page-banner { 
      min-height: 40vh; 
      padding-top: 120px; 
      padding-bottom: 80px; 
    }
  }
</style>
