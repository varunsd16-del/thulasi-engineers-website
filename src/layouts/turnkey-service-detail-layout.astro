---
import BaseLayout from './engineering-authority-layout.astro';
import ContactMini from '../components/features/contact/ContactMini.astro';
import FAQSection from '../components/features/seo/civil-engineering-faqs.astro';

const { service } = Astro.props;
---

<BaseLayout title={service.title} description={service.description}>
  <!-- Cinematic Page Banner -->
  <section class="page-banner">
    <div class="page-banner__bg">
      <img src={service.image} alt={service.title} class="banner-img" />
      <div class="page-banner__overlay"></div>
    </div>
    
    <div class="container page-banner__content reveal-up">
      <div class="section-badge">
        ENGINEERING SERVICE AUTHORITY
      </div>
      
      <h1 class="page-banner__title">{service.shortTitle}</h1>
      <p class="page-banner__subtitle">{service.description}</p>
      
      <nav class="breadcrumb">
        <a href="/" class="magnetic-elem">Home</a>
        <span class="sep">/</span>
        <a href="/services" class="magnetic-elem">Services</a>
        <span class="sep">/</span>
        <span class="current">{service.shortTitle}</span>
      </nav>
    </div>

    <!-- Wave Separator -->
    <div class="banner-wave">
      <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M985.66,92.83C906.67,72,823.78,31,743.84,14.19c-82.26-17.34-168.06-16.33-250.45.39-57.84,11.73-114,31.07-172,41.86A600.21,600.21,0,0,1,0,27.35V120H1200V95.8C1132.19,118.92,1055.71,111.31,985.66,92.83Z" class="shape-fill"></path>
      </svg>
    </div>
  </section>

  <!-- Service Detail Content -->
  <section class="service-details">
    <div class="container">
      <div class="details-grid">
        <div class="details-main reveal-up">
          <div class="details-text">
            <slot />
          </div>
          
          {service.features && (
            <div class="features-box">
              <h3>Key Benefits</h3>
              <div class="features-grid">
                {service.features.map((feature, index) => (
                  <div class="feature-item" style={`transition-delay: ${index * 0.05}s`}>
                    <span class="check">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="20 6 9 17 4 12"/>
                      </svg>
                    </span>
                    <span>{feature}</span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        <aside class="details-sidebar reveal-up" style="transition-delay: 0.2s;">
          <div class="sidebar-card cta-card">
            <h4>Get a Quote</h4>
            <p>Ready to start your {service.shortTitle} project in Trichy?</p>
            <a href="/contact" class="btn-gold w-full">REQUEST A CALL BACK →</a>
          </div>

          <div class="sidebar-card">
            <h4>Our Expertise</h4>
            <div class="expertise-stat">
              <strong>10+</strong>
              <span>Years Experience</span>
            </div>
            <div class="expertise-stat">
              <strong>30+</strong>
              <span>Success Stories</span>
            </div>
          </div>

          <div class="sidebar-card">
            <h4>Why Choose Us</h4>
            <ul class="why-list-small">
              <li>✓ Registered Civil Engineers</li>
              <li>✓ A-Class Contractors</li>
              <li>✓ 100% Transparent Pricing</li>
              <li>✓ Premium Quality Materials</li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {service.faqs && <FAQSection faqs={service.faqs} title={`Frequently Asked Questions: ${service.shortTitle}`} />}
  <ContactMini />
</BaseLayout>

<style>
  /* CSS Variables */
  :root {
    --navy: #0d1b3e;
    --gold: #c5a059;
    --gold-light: #d4af37;
    --text-muted: #4b5563;
    --bg-white: #ffffff;
    --bg-light: #f8fafc;
    --border-light: rgba(13, 27, 62, 0.08);
  }

  /* Page Banner */
  .page-banner {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: center;
    background: var(--navy);
    overflow: visible;
    padding-top: 140px;
    padding-bottom: 120px;
    border: none !important;
  }

  .banner-wave {
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    z-index: 5;
  }

  .banner-wave svg {
    position: relative;
    display: block;
    width: calc(100% + 1.3px);
    height: 80px;
    transform: translateY(1px);
  }

  .banner-wave .shape-fill {
    fill: var(--bg-white);
  }

  .page-banner__bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.2;
  }

  .page-banner__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--navy) 0%, rgba(13, 27, 62, 0.85) 50%, rgba(13, 27, 62, 0.7) 100%);
    z-index: 2;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 60px;
    position: relative;
    z-index: 10;
  }

  .page-banner__content {
    max-width: 800px;
  }

  .section-badge {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--gold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 15px;
    display: inline-block;
  }

  .page-banner__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.1;
    color: #ffffff;
    margin-bottom: 20px;
  }

  .page-banner__subtitle {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    margin-bottom: 30px;
    max-width: 600px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    flex-wrap: wrap;
    justify-content: flex-start;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .breadcrumb a:hover {
    color: var(--gold);
  }

  .breadcrumb .sep {
    color: rgba(255, 255, 255, 0.4);
  }

  .breadcrumb .current {
    color: var(--gold);
  }

  /* Service Details */
  .service-details { 
    padding: 100px 0; 
    background: var(--bg-white); 
  }

  .details-grid { 
    display: grid; 
    grid-template-columns: 8fr 4fr; 
    gap: 60px; 
  }

  /* Main Content */
  .details-text :global(h2) { 
    font-size: 2rem; 
    font-weight: 800; 
    margin-bottom: 25px; 
    color: var(--navy); 
    line-height: 1.2; 
  }

  .details-text :global(h3) { 
    font-size: 1.5rem; 
    font-weight: 700; 
    margin-top: 45px; 
    margin-bottom: 20px; 
    color: var(--navy); 
  }

  .details-text :global(h4) { 
    font-size: 1.2rem; 
    font-weight: 700; 
    margin-top: 30px; 
    margin-bottom: 15px; 
    color: var(--navy); 
  }

  .details-text :global(p) { 
    font-size: 1rem; 
    line-height: 1.75; 
    color: var(--text-muted); 
    margin-bottom: 25px; 
  }

  .details-text :global(strong) { 
    color: var(--navy); 
    font-weight: 700; 
  }

  .details-text :global(a) {
    color: var(--gold);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: all 0.3s ease;
  }

  .details-text :global(a:hover) {
    color: var(--gold-light);
    border-bottom-color: var(--gold);
  }

  .details-text :global(ul) { 
    margin-bottom: 30px; 
    padding-left: 20px; 
  }

  .details-text :global(li) { 
    margin-bottom: 12px; 
    font-size: 1rem; 
    color: var(--text-muted); 
    line-height: 1.7;
  }

  .details-text :global(li strong) {
    color: var(--navy);
  }

  .details-text :global(blockquote) { 
    border-left: 4px solid var(--gold); 
    padding: 20px 30px; 
    background: var(--bg-light); 
    font-style: italic; 
    margin: 40px 0; 
    border-radius: 0 16px 16px 0; 
  }

  .details-text :global(img) {
    border-radius: 16px;
    width: 100%;
    height: auto;
    margin: 30px 0;
  }

  /* Features Box */
  .features-box {
    margin-top: 60px;
    padding: 40px;
    background: var(--bg-light);
    border-radius: 20px;
    border: 1px solid var(--border-light);
  }

  .features-box h3 { 
    font-size: 1.4rem; 
    margin-bottom: 30px; 
    font-weight: 800; 
    color: var(--navy);
  }

  .features-grid { 
    display: grid; 
    grid-template-columns: 1fr 1fr; 
    gap: 20px; 
  }

  .feature-item { 
    display: flex; 
    gap: 12px; 
    align-items: center; 
    font-weight: 600; 
    color: var(--navy); 
    font-size: 0.95rem; 
  }

  .feature-item .check { 
    color: var(--gold); 
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-item .check svg {
    width: 18px;
    height: 18px;
    stroke: var(--gold);
  }

  /* Sidebar */
  .sidebar-card {
    padding: 32px;
    background: var(--bg-white);
    border: 1px solid var(--border-light);
    border-radius: 20px;
    margin-bottom: 30px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
  }

  .sidebar-card h4 { 
    font-size: 1.2rem; 
    font-weight: 800; 
    margin-bottom: 20px; 
    color: var(--navy);
  }

  .sidebar-card p { 
    font-size: 0.9rem; 
    margin-bottom: 25px; 
    color: var(--text-muted); 
    line-height: 1.6;
  }

  /* CTA Card */
  .cta-card {
    background: linear-gradient(135deg, var(--navy) 0%, #1a2b5e 100%);
    border: none;
  }

  .cta-card h4 {
    color: #ffffff;
  }

  .cta-card p {
    color: rgba(255, 255, 255, 0.8);
  }

  .btn-gold {
    display: inline-block;
    background: var(--gold);
    color: var(--navy);
    border: none;
    padding: 12px 24px;
    font-weight: 700;
    font-size: 0.75rem;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 4px;
    transition: all 0.3s ease;
    text-align: center;
  }

  .btn-gold:hover {
    background: var(--gold-light);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(197, 160, 89, 0.3);
  }

  .w-full {
    width: 100%;
    display: block;
  }

  /* Expertise Stats */
  .expertise-stat {
    display: flex;
    flex-direction: column;
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--border-light);
  }

  .expertise-stat:first-of-type {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .expertise-stat strong { 
    font-size: 2rem; 
    line-height: 1; 
    color: var(--gold); 
    font-weight: 800; 
  }

  .expertise-stat span { 
    font-size: 0.7rem; 
    text-transform: uppercase; 
    color: var(--text-muted); 
    letter-spacing: 0.08em; 
    font-weight: 700; 
    margin-top: 5px; 
  }

  /* Why Choose Us List */
  .why-list-small {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .why-list-small li {
    padding: 8px 0;
    font-size: 0.85rem;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-light);
  }

  .why-list-small li:last-child {
    border-bottom: none;
  }

  /* Reveal Animation */
  .reveal-up {
    opacity: 0;
    transform: translateY(30px);
    animation: revealUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes revealUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .container {
      padding: 0 40px;
    }

    .details-grid { 
      grid-template-columns: 1fr; 
      gap: 50px; 
    }

    .features-grid { 
      grid-template-columns: 1fr; 
    }

    .page-banner {
      min-height: 45vh;
      padding-top: 130px;
      padding-bottom: 80px;
    }
  }

  @media (max-width: 768px) {
    .service-details { 
      padding: 60px 0; 
    }

    .container {
      padding: 0 24px;
    }

    .page-banner__title {
      font-size: 2rem;
    }

    .page-banner__subtitle {
      font-size: 0.95rem;
    }

    .details-text :global(h2) { 
      font-size: 1.6rem; 
    }

    .details-text :global(h3) { 
      font-size: 1.3rem; 
    }

    .details-text :global(p), 
    .details-text :global(li) { 
      font-size: 0.95rem; 
    }

    .features-box {
      padding: 25px;
    }

    .features-box h3 {
      font-size: 1.2rem;
    }

    .sidebar-card {
      padding: 25px;
    }

    .sidebar-card h4 {
      font-size: 1.1rem;
    }

    .breadcrumb {
      justify-content: center;
      text-align: center;
      gap: 6px;
      font-size: 0.75rem;
    }

    .breadcrumb .sep {
      margin: 0 2px;
    }
  }

  @media (min-width: 1400px) {
    .container {
      padding: 0 80px;
    }
  }
</style>