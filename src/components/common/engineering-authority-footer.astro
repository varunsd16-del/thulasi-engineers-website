---
import { SITE_METADATA, NAVIGATION } from '../../app/config/site.ts';
---

<footer class="site-footer">
  <div class="footer__glow"></div>

  <div class="container footer__inner">
    <div class="footer__grid">
      
      <!-- Column 1: Brand & Bio -->
      <div class="footer__col footer__col--brand reveal-up">
        <a href="/" class="footer__logo-link magnetic-elem">
          <img src="/images/hero/thulasi-engineers-branding-logo.webp" alt={SITE_METADATA.name} class="footer__logo-img" />
        </a>
        <p class="footer__text">
          Registered <strong class="text-gold">Civil Engineers</strong> and <strong class="text-gold">A-Class Building Contractors</strong> in Trichy. Delivering architectural excellence and structural integrity since 2014.
        </p>
        <div class="footer__socials">
          <a href={SITE_METADATA.social.facebook} class="social-link magnetic-elem" title="Facebook" aria-label="Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
          </a>
          <a href={SITE_METADATA.social.whatsapp} class="social-link magnetic-elem" title="WhatsApp" aria-label="WhatsApp">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l2.27-2.28a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
          </a>
          <a href={SITE_METADATA.social.instagram} class="social-link magnetic-elem" title="Instagram" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="4"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Specialized Services -->
      <div class="footer__col reveal-up" style="transition-delay: 0.1s;">
        <h4 class="footer__title">Specialized Services</h4>
        <div class="footer__rule"></div>
        <div class="footer__links-grid">
          <ul class="footer__links">
            <li><a href="/services/building-construction"><span class="link-text">Building Build</span><span class="arrow">→</span></a></li>
            <li><a href="/services/industrial-construction"><span class="link-text">Industrial</span><span class="arrow">→</span></a></li>
            <li><a href="/services/infrastructure-development"><span class="link-text">Infrastructure</span><span class="arrow">→</span></a></li>
            <li><a href="/services/renovation-remodeling"><span class="link-text">Renovation</span><span class="arrow">→</span></a></li>
          </ul>
          <ul class="footer__links">
            <li><a href="/services/architecture-planning"><span class="link-text">Architecture</span><span class="arrow">→</span></a></li>
            <li><a href="/services/project-management"><span class="link-text">Consultancy</span><span class="arrow">→</span></a></li>
            <li><a href="/services/safety-management"><span class="link-text">Safety Mgmt</span><span class="arrow">→</span></a></li>
            <li><a href="/services/sustainable-construction"><span class="link-text">Green Build</span><span class="arrow">→</span></a></li>
          </ul>
        </div>
      </div>

      <!-- Column 3: Local Authority -->
      <div class="footer__col reveal-up" style="transition-delay: 0.2s;">
        <h4 class="footer__title">Local Authority</h4>
        <div class="footer__rule"></div>
        <ul class="footer__links footer__links--single">
          <li><a href="/areas-we-serve"><span class="link-text">Srirangam Hub</span><span class="arrow">→</span></a></li>
          <li><a href="/areas-we-serve"><span class="link-text">Thillai Nagar</span><span class="arrow">→</span></a></li>
          <li><a href="/areas-we-serve"><span class="link-text">KK Nagar Area</span><span class="arrow">→</span></a></li>
          <li><a href="/areas-we-serve"><span class="link-text">BHEL Township</span><span class="arrow">→</span></a></li>
          <li><a href="/areas-we-serve"><span class="link-text">Cantonment</span><span class="arrow">→</span></a></li>
          <li><a href="/areas-we-serve"><span class="link-text">Tiruverumbur</span><span class="arrow">→</span></a></li>
        </ul>
      </div>

      <!-- Column 4: Contact & Directions -->
      <div class="footer__col reveal-up" style="transition-delay: 0.3s;">
        <h4 class="footer__title">Head Office</h4>
        <div class="footer__rule"></div>
        <div class="footer__contact">
          <a href="https://maps.google.com" target="_blank" rel="noopener noreferrer" class="contact-item hover-accent">
            <div class="contact-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <span>{SITE_METADATA.address.street},<br/>{SITE_METADATA.address.city} - {SITE_METADATA.address.zip}</span>
          </a>
          <a href={`tel:${SITE_METADATA.whatsapp.replace('+', '')}`} class="contact-item hover-accent">
            <div class="contact-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.81 19.79 19.79 0 01.22 2.18 2 2 0 012.18 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.91 7.91a16 16 0 006.18 6.18l1.27-1.52a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
            </div>
            <span>{SITE_METADATA.phone}</span>
          </a>
          
          <a href="https://maps.google.com" target="_blank" rel="noopener noreferrer" class="btn-outline magnetic-elem">
            <span class="btn-text">Get Directions →</span>
          </a>
        </div>
      </div>

    </div>
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p class="copyright">© <span id="year"></span> {SITE_METADATA.name}. Licensed A-Class Contractors.</p>
      <div class="footer__bottom-links">
        <a href="/privacy" class="hover-accent">Privacy Policy</a>
        <span class="sep"></span>
        <a href="/terms" class="hover-accent">Terms of Service</a>
        <span class="sep"></span>
        <a href="/sitemap.xml" class="hover-accent">Sitemap</a>
      </div>
    </div>
  </div>
</footer>

<style>
  :root {
    --dark-bg: #0d1b3e;
    --dark-bg-light: #1a2b5e;
    --accent-gold: #c5a059;
    --accent-gold-light: #d4af37;
    --text-white: #ffffff;
    --text-muted: rgba(255, 255, 255, 0.9);
    --border-subtle: rgba(197, 160, 89, 0.15);
  }

  .site-footer {
    position: relative;
    background: var(--dark-bg);
    color: var(--text-white);
    padding: 80px 0 0;
    font-family: var(--font-body);
    border-top: 1px solid var(--border-subtle);
    overflow: hidden;
  }

  .footer__glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    height: 200px;
    background: radial-gradient(ellipse at top, rgba(197, 160, 89, 0.08) 0%, transparent 70%);
    z-index: 1;
    pointer-events: none;
  }

  .container {
    position: relative;
    z-index: 5;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 5%;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1.2fr 0.8fr 1fr;
    gap: 50px;
    margin-bottom: 60px;
  }

  /* Reveal Animation Utility */
  .reveal-up {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .reveal-up.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .footer__logo-link {
    display: inline-block;
    margin-bottom: 0px;
  }

  .footer__logo-img {
    height: 100px;
    width: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  .footer__text {
    font-size: 0.9rem;
    color: #ffffff;
    line-height: 1.7;
    margin-bottom: 28px;
    max-width: 380px;
  }

  .text-gold {
    color: var(--accent-gold);
    font-weight: 600;
  }

  .footer__title {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--accent-gold);
    letter-spacing: 0.15em;
    margin-bottom: 16px;
    text-transform: uppercase;
  }

  /* Gold accent rule */
  .footer__rule {
    width: 40px;
    height: 2px;
    background: var(--accent-gold);
    margin-bottom: 28px;
    opacity: 0.8;
  }

  .footer__links-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .footer__links,
  .footer__links--single {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .footer__links li,
  .footer__links--single li {
    margin: 0;
  }

  .footer__links a,
  .footer__links--single a {
    color: #ffffff;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.3s ease;
    position: relative;
  }

  .footer__links a .arrow,
  .footer__links--single a .arrow {
    opacity: 0;
    transform: translateX(-6px);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    color: var(--accent-gold);
    font-size: 0.9rem;
  }

  .footer__links a:hover,
  .footer__links--single a:hover {
    color: var(--accent-gold);
  }

  .footer__links a:hover .arrow,
  .footer__links--single a:hover .arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .footer__contact {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .contact-item {
    display: flex;
    gap: 14px;
    font-size: 0.85rem;
    color: #ffffff;
    line-height: 1.6;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .contact-item:hover {
    color: var(--accent-gold);
  }

  .contact-icon {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    color: var(--accent-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(197, 160, 89, 0.1);
    border-radius: 50%;
  }

  .contact-icon svg {
    width: 18px;
    height: 18px;
  }

  .hover-accent:hover {
    color: var(--accent-gold);
  }

  .btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 8px;
    padding: 12px 24px;
    background: transparent;
    border: 1.5px solid var(--accent-gold);
    color: var(--accent-gold);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.3s ease;
    width: fit-content;
    cursor: pointer;
  }

  .btn-outline:hover {
    background: var(--accent-gold);
    color: var(--dark-bg);
    border-color: var(--accent-gold);
    transform: translateY(-2px);
  }

  /* Social Links */
  .footer__socials {
    display: flex;
    gap: 12px;
  }

  .social-link {
    width: 38px;
    height: 38px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(197, 160, 89, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: var(--text-white);
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .social-link svg {
    width: 16px;
    height: 16px;
  }

  .social-link:hover {
    background: var(--accent-gold);
    border-color: var(--accent-gold);
    color: var(--dark-bg);
    transform: translateY(-3px);
  }

  /* Bottom Bar */
  .footer__bottom {
    background: rgba(0, 0, 0, 0.3);
    padding: 20px 0;
    border-top: 1px solid var(--border-subtle);
    position: relative;
    z-index: 5;
  }

  .footer__bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .copyright {
    margin: 0;
    color: #ffffff;
  }

  .footer__bottom-links {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .footer__bottom-links a {
    color: #ffffff;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .footer__bottom-links a:hover {
    color: var(--accent-gold);
  }

  .sep {
    width: 3px;
    height: 3px;
    background: var(--border-subtle);
    border-radius: 50%;
  }

  /* Responsive Constraints */
  @media (max-width: 1200px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 50px;
    }
  }

  @media (max-width: 768px) {
    .site-footer { 
      padding: 60px 0 0; 
    }
    
    .footer__grid {
      grid-template-columns: 1fr;
      gap: 45px;
    }
    
    .footer__links-grid {
      grid-template-columns: 1fr;
    }
    
    .footer__bottom-inner {
      flex-direction: column;
      gap: 16px;
      text-align: center;
    }
    
    .footer__bottom-links {
      flex-wrap: wrap;
      justify-content: center;
    }
    
    .footer__logo-img {
      height: 80px;
    }
    
    .footer__text {
      max-width: 100%;
    }
  }

  @media (max-width: 480px) {
    .footer__grid {
      gap: 40px;
    }
    
    .footer__title {
      font-size: 0.65rem;
    }
    
    .footer__links a,
    .footer__links--single a {
      font-size: 0.8rem;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // 1. Dynamic Year Update
    const yearEl = document.getElementById('year');
    if(yearEl) yearEl.textContent = new Date().getFullYear().toString();

    // 2. Intersection Observer for Scroll Reveals
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.15
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    const revealElements = document.querySelectorAll('.reveal-up');
    revealElements.forEach(el => observer.observe(el));

    // 3. Magnetic Hover Interaction (Desktop Only)
    const magneticElems = document.querySelectorAll('.magnetic-elem');
    
    if (window.matchMedia("(pointer: fine)").matches) {
      magneticElems.forEach(elem => {
        const text = elem.querySelector('.btn-text');
        
        elem.addEventListener('mousemove', (e) => {
          const rect = elem.getBoundingClientRect();
          const x = e.clientX - rect.left - rect.width / 2;
          const y = e.clientY - rect.top - rect.height / 2;
          
          elem.style.transform = `translate(${x * 0.2}px, ${y * 0.2}px)`;
          if(text) text.style.transform = `translate(${x * 0.1}px, ${y * 0.1}px)`;
        });

        elem.addEventListener('mouseleave', () => {
          elem.style.transform = 'translate(0px, 0px)';
          if(text) text.style.transform = 'translate(0px, 0px)';
          
          elem.style.transition = 'transform 0.4s cubic-bezier(0.16, 1, 0.3, 1)';
          if(text) text.style.transition = 'transform 0.4s cubic-bezier(0.16, 1, 0.3, 1)';
          
          setTimeout(() => {
            elem.style.transition = '';
            if(text) text.style.transition = '';
          }, 400);
        });
      });
    }
  });
</script>