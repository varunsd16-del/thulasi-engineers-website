---
interface Props {
  answer: string;
}

const { answer } = Astro.props;
---

<div class="ai-answer-box">
  <div class="ai-answer-box__header">
    <div class="ai-badge">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8z"></path>
        <path d="M12 6v6l4 2"></path>
      </svg>
      QUICK AI ANSWER
    </div>
  </div>
  <div class="ai-answer-box__content">
    <p>{answer}</p>
  </div>
  <div class="ai-answer-box__footer">
    <span>Optimized for AI Search & Voice Assistant</span>
  </div>
</div>

<style>
  .ai-answer-box {
    background: #f0f4ff;
    border: 1px solid #d0deff;
    border-radius: 16px;
    padding: 30px;
    margin: 40px 0;
    position: relative;
    overflow: hidden;
  }

  .ai-answer-box::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: #3b82f6;
  }

  .ai-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #3b82f6;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 6px 12px;
    border-radius: 20px;
    margin-bottom: 20px;
    letter-spacing: 1px;
  }

  .ai-badge svg {
    width: 14px;
    height: 14px;
  }

  .ai-answer-box__content p {
    font-size: 1.15rem;
    line-height: 1.6;
    color: #1e3a8a;
    font-weight: 600;
    margin: 0;
  }

  .ai-answer-box__footer {
    margin-top: 20px;
    font-size: 0.7rem;
    color: #64748b;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
</style>
