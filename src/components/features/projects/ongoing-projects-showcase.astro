---
import fs from 'node:fs';
import path from 'node:path';

// Load ongoing projects dynamically from public/images/ongoing projects
const ongoingDir = path.resolve('public/images/ongoing projects');
let filenames = [];
try {
  filenames = fs.readdirSync(ongoingDir);
} catch (err) {
  console.error("Error reading ongoing projects directory:", err);
}

const images = filenames.filter(file => /\.(webp|png|jpe?g|svg)$/i.test(file));

const locationsList = [
  { name: 'srirangam', label: 'Srirangam' },
  { name: 'thillai-nagar', label: 'Thillai Nagar' },
  { name: 'kk-nagar', label: 'KK Nagar' },
  { name: 'woraiyur', label: 'Woraiyur' },
  { name: 'cantonment', label: 'Cantonment' },
  { name: 'karumandapam', label: 'Karumandapam' },
  { name: 'puthur', label: 'Puthur' },
  { name: 'tiruverumbur', label: 'Tiruverumbur' },
  { name: 'samayapuram', label: 'Samayapuram' },
  { name: 'golden-rock', label: 'Golden Rock' },
  { name: 'lalgudi', label: 'Lalgudi' },
  { name: 'manapparai', label: 'Manapparai' },
  { name: 'thuvakudi', label: 'Thuvakudi' },
  { name: 'panjapur', label: 'Panjapur' }
];

const projects = images.map((filename, index) => {
  let name = filename.replace(/\.(webp|png|jpe?g)$/i, '');
  let locationLabel = 'Trichy';
  
  const foundLoc = locationsList.find(loc => name.toLowerCase().includes(loc.name));
  if (foundLoc) {
    locationLabel = foundLoc.label;
    name = name.replace(new RegExp(`-?${foundLoc.name}-?`, 'i'), '');
  }
  
  name = name.replace('-trichy', '').replace('-in', '');
  
  let title = name.split('-').map(word => {
    if (word.toUpperCase() === 'PEB') return 'PEB';
    if (word.toUpperCase() === 'PMC') return 'PMC';
    return word.charAt(0).toUpperCase() + word.slice(1);
  }).join(' ');

  return {
    src: `/images/ongoing projects/${filename}`,
    alt: title
  };
});
---

<section class="ongoing-projects-section reveal-up">
