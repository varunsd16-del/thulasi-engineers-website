<script is:inline define:vars={{ projects }}>
  document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('.ongoing-card');
    if (!cards.length || !projects.length) return;

    // Distribute starting indexes for the 8 cards
    const startIndexes = [0, 2, 4, 6, 8, 10, 11, 12];
    const currentIndexes = [...startIndexes];

    // Function to update a specific card with fade effect
    function updateCard(card, projectIndex) {
      const proj = projects[projectIndex % projects.length];
      const img = card.querySelector('.ongoing-card__image');

      // Start fade out transition
      img.style.opacity = '0';

      setTimeout(() => {
        // Set new values
        img.src = proj.src;
        img.alt = proj.alt;

        // Start fade in transition
        img.style.opacity = '1';
      }, 500);
    }

    // Initialize all 8 cards immediately
    cards.forEach((card, i) => {
      updateCard(card, currentIndexes[i]);
    });

    // Staggered image cycling loops
    cards.forEach((card, i) => {
      // Stagger start times: Card i cycles with a slow, calm stagger offset
      setTimeout(() => {
        // Run first rotation
        currentIndexes[i] = (currentIndexes[i] + 1) % projects.length;
        updateCard(card, currentIndexes[i]);

        // Setup the recurring timer for this specific card to be very slow (24 seconds)
        setInterval(() => {
          currentIndexes[i] = (currentIndexes[i] + 1) % projects.length;
          updateCard(card, currentIndexes[i]);
        }, 24000); 
      }, 4000 + (i * 3000)); // Stagger card swaps by 3 seconds
    });
  });
</script>

<style>
  :root {
    --navy: #0d1b3e;
    --gold: #c5a059;
    --gold-light: #d4af37;
    --card-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    --border-color: rgba(226, 232, 240, 0.8);
  }

  .ongoing-projects-section {
    padding: 100px 0;
    background: #ffffff;
    overflow: hidden;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .section-header {
    margin-bottom: 60px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .section-badge {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--gold);
    letter-spacing: 0.25em;
    text-transform: uppercase;
    margin-bottom: 15px;
  }

  .section-title {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    color: var(--navy);
    line-height: 1.15;
    margin-bottom: 20px;
  }

  .text-gold {
    color: var(--gold);
  }

  .heading-accent-line {
    width: 70px;
    height: 3px;
    background: var(--gold);
    margin: 15px auto 25px auto;
    border-radius: 2px;
  }

  .section-desc {
    font-size: 1.05rem;
    color: #556080;
    max-width: 650px;
    line-height: 1.7;
  }

  .center-desc {
    text-align: center;
  }

  /* Ongoing Projects Grid */
  .ongoing-projects-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
  }

  /* Card Styles */
  .ongoing-card {
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--card-shadow);
    border: 1px solid var(--border-color);
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    display: flex;
    flex-direction: column;
    aspect-ratio: 4/3;
  }

  .ongoing-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(13, 27, 62, 0.1);
    border-color: rgba(197, 160, 89, 0.3);
  }

  .ongoing-card__image-container {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #f1f5f9;
  }

  .ongoing-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.5s ease-in-out, transform 0.8s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  .ongoing-card:hover .ongoing-card__image {
    transform: scale(1.08);
  }

  /* Responsive styling */
  @media (max-width: 1024px) {
    .container {
      padding: 0 20px;
    }
    .ongoing-projects-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 640px) {
    .ongoing-projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
