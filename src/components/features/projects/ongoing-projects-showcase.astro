      <p class="section-desc center-desc">Real-time status updates from our active construction sites across Trichy. Watch them evolve live.</p>
    </div>

    <div class="ongoing-projects-grid">
      <!-- Card 1 -->
      <div class="ongoing-card reveal-up">
        <div class="ongoing-card__image-container">
