---
// CostCalculator.astro - Interactive Construction Cost Estimator
---

<section class="cost-calculator" id="calculator">
  <div class="container">
    <div class="calculator-card">
      <div class="calculator-header">
        <div class="section-label">ESTIMATION TOOL</div>
        <h2 class="calculator-title">Construction <span>Cost Calculator</span></h2>
        <p>Get a rough estimate for your construction project in Trichy instantly.</p>
      </div>

      <div class="calculator-body">
        <div class="calc-group">
          <label for="area">Built-up Area (Sq.Ft.)</label>
          <input type="number" id="area" placeholder="e.g. 1500" value="1000" />
          <input type="range" id="areaRange" min="500" max="10000" step="50" value="1000" />
        </div>

        <div class="calc-group">
          <label>Quality Standard</label>
          <div class="quality-options">
            <label class="quality-radio">
              <input type="radio" name="quality" value="1850" checked />
              <div class="radio-content">
                <strong>Standard</strong>
                <span>₹2,250/sq.ft</span>
              </div>
            </label>
            <label class="quality-radio">
              <input type="radio" name="quality" value="2150" />
              <div class="radio-content">
                <strong>Premium</strong>
                <span>₹2,400/sq.ft</span>
              </div>
            </label>
            <label class="quality-radio">
              <input type="radio" name="quality" value="2450" />
              <div class="radio-content">
                <strong>Luxury</strong>
                <span>₹2,600/sq.ft</span>
              </div>
            </label>
          </div>
        </div>

        <div class="calc-result">
          <div class="result-item">
            <span>Estimated Total Cost</span>
            <h3 id="totalCost">₹ 18,50,000</h3>
          </div>
          <p class="disclaimer">*Excluding land cost, approvals, and compound wall. Prices are subject to change based on specific site conditions in Trichy.</p>
          <a href="/contact" class="btn btn--red w-full">GET DETAILED QUOTATION</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const areaInput = document.getElementById('area') as HTMLInputElement;
  const areaRange = document.getElementById('areaRange') as HTMLInputElement;
  const qualityRadios = document.querySelectorAll('input[name="quality"]');
  const totalCostDisplay = document.getElementById('totalCost');

  function calculate() {
    const area = parseFloat(areaInput.value) || 0;
    let rate = 1850;
    qualityRadios.forEach((radio: any) => {
      if (radio.checked) rate = parseFloat(radio.value);
    });

    const total = area * rate;
    if (totalCostDisplay) {
      totalCostDisplay.innerText = `₹ ${total.toLocaleString('en-IN')}`;
    }
  }

  areaInput?.addEventListener('input', () => {
    if (areaRange) areaRange.value = areaInput.value;
    calculate();
  });

  areaRange?.addEventListener('input', () => {
    if (areaInput) areaInput.value = areaRange.value;
    calculate();
  });

  qualityRadios.forEach(radio => {
    radio.addEventListener('change', calculate);
  });
</script>

<style>
  .cost-calculator { padding: 100px 0; background: #f8f9fa; }
  .calculator-card { background: #fff; border-radius: 30px; box-shadow: 0 40px 100px rgba(0,0,0,0.08); overflow: hidden; max-width: 1000px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1.2fr; }
  
  @media (max-width: 900px) {
    .calculator-card { grid-template-columns: 1fr; }
    .calculator-header, .calculator-body { padding: 40px; }
  }

  @media (max-width: 600px) {
    .cost-calculator { padding: 60px 0; }
    .calculator-header, .calculator-body { padding: 30px 20px; }
    .calculator-title { font-size: 1.8rem; }
    .result-item h3 { font-size: 1.8rem; }
    .quality-options { grid-template-columns: 1fr; }
    .radio-content { display: flex; justify-content: space-between; align-items: center; padding: 12px 20px; text-align: left; }
    .radio-content strong { margin-bottom: 0; }
  }

  @media (max-width: 400px) {
    .calculator-title { font-size: 1.5rem; }
    .result-item h3 { font-size: 1.5rem; }
  }

  .calculator-header { background: var(--black); color: #fff; padding: 60px; display: flex; flex-direction: column; justify-content: center; }
  .calculator-title { font-family: var(--font-head); font-size: 2.2rem; font-weight: 800; margin-bottom: 20px; color: #fff; line-height: 1.2; }
  .calculator-title span { color: var(--red); }
  .calculator-header p { opacity: 0.7; font-size: 1rem; line-height: 1.6; }

  .calculator-body { padding: 60px; }
  .calc-group { margin-bottom: 35px; }
  .calc-group label { display: block; font-weight: 800; font-size: 0.9rem; margin-bottom: 15px; color: var(--black); text-transform: uppercase; letter-spacing: 1px; }
  
  input[type="number"] { width: 100%; padding: 15px; border: 2px solid #eee; border-radius: 12px; font-size: 1.2rem; font-weight: 700; margin-bottom: 15px; }
  input[type="range"] { width: 100%; accent-color: var(--red); }

  .quality-options { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .quality-radio { cursor: pointer; }
  .quality-radio input { display: none; }
  .radio-content { padding: 15px; border: 2px solid #eee; border-radius: 12px; text-align: center; transition: all 0.3s; }
  .radio-content strong { display: block; font-size: 0.9rem; margin-bottom: 4px; }
  .radio-content span { font-size: 0.75rem; color: var(--gray-mid); font-weight: 600; }
  
  .quality-radio input:checked + .radio-content { border-color: var(--red); background: rgba(224, 32, 32, 0.05); }
  .quality-radio input:checked + .radio-content strong { color: var(--red); }

  .calc-result { background: #fdfdfd; padding: 30px 20px; border-radius: 20px; border: 1px dashed var(--gray-border); margin-top: 20px; }
  .result-item { margin-bottom: 20px; text-align: center; }
  .result-item span { font-size: 0.8rem; font-weight: 700; color: var(--gray-mid); text-transform: uppercase; letter-spacing: 1px; }
  .result-item h3 { font-family: var(--font-head); font-size: 2.5rem; color: var(--black); font-weight: 900; margin-top: 8px; word-break: break-all; }
  
  .disclaimer { font-size: 0.7rem; color: var(--gray-mid); line-height: 1.6; margin-bottom: 25px; text-align: center; }
  .w-full { width: 100%; display: block; text-align: center; }
</style>
</style>
