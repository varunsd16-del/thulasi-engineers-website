---
interface Props {
  category: {
    title: string;
    description: string;
    target: string;
  };
}

const { category } = Astro.props;

// Split title for emphasis
const words = category.title.split(' ');
const firstWord = words[0];
const remainingWords = words.slice(1).join(' ');
---

<section class="page-banner">
  <div class="page-banner__bg">
    <img src="/images/localities/stormwater-drain-civil-infrastructure-trichy.webp" alt={category.title} class="banner-img" />
    <div class="page-banner__overlay"></div>
  </div>
  <div class="container page-banner__content reveal-up">
    <div class="section-badge-pill">
      <span class="status-dot"></span>
      ENGINEERING AUTHORITY HUB
    </div>
    <h1 class="page-banner__title">{firstWord} <span class="text-gold">{remainingWords} INSIGHTS</span></h1>
    <p class="page-banner__subtitle">{category.description}</p>
    
    <nav class="breadcrumb">
      <a href="/" class="magnetic-elem">Home</a>
      <span class="sep">/</span>
      <a href="/blog" class="magnetic-elem">Blog</a>
      <span class="sep">/</span>
      <span class="current">{category.title}</span>
    </nav>
  </div>

  <!-- Wave Separator -->
  <div class="banner-wave">
    <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
      <path d="M985.66,92.83C906.67,72,823.78,31,743.84,14.19c-82.26-17.34-168.06-16.33-250.45.39-57.84,11.73-114,31.07-172,41.86A600.21,600.21,0,0,1,0,27.35V120H1200V95.8C1132.19,118.92,1055.71,111.31,985.66,92.83Z" class="shape-fill"></path>
    </svg>
  </div>
</section>

<style>
  /* CSS Variables for Light Theme */
  :root {
    --navy: #0d1b3e;
    --gold: #c5a059;
    --gold-light: #d4af37;
    --text-muted: #4b5563;
  }

  /* Page Banner */
  .page-banner {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: center;
    background: var(--navy);
    overflow: visible;
    padding-top: 140px;
    padding-bottom: 120px;
    border: none !important;
  }

  .banner-wave {
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    z-index: 5;
  }

  .banner-wave svg {
    position: relative;
    display: block;
    width: calc(100% + 1.3px);
    height: 80px;
    transform: translateY(1px);
  }

  .banner-wave .shape-fill {
    fill: var(--bg-white);
  }

  .page-banner__bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.2;
  }

  .page-banner__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--navy) 0%, rgba(13, 27, 62, 0.85) 50%, rgba(13, 27, 62, 0.7) 100%);
    z-index: 2;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 60px;
    position: relative;
    z-index: 10;
  }

  .page-banner__content {
    max-width: 800px;
  }

  .section-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--gold);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 20px;
    background: rgba(197, 160, 89, 0.1);
    padding: 5px 15px;
    border-radius: 50px;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    background: var(--gold);
    border-radius: 50%;
    display: inline-block;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(1.2);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  .page-banner__title {
    font-size: clamp(2rem, 5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.2;
    color: #ffffff;
    margin-bottom: 20px;
  }

  .text-gold {
    color: var(--gold);
    position: relative;
    display: inline-block;
  }

  .text-gold::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--gold);
    border-radius: 2px;
  }

  .page-banner__subtitle {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    margin-bottom: 30px;
    max-width: 600px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    flex-wrap: wrap;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .breadcrumb a:hover {
    color: var(--gold);
  }

  .breadcrumb .sep {
    color: rgba(255, 255, 255, 0.4);
  }

  .breadcrumb .current {
    color: var(--gold);
  }

  /* Reveal Animation */
  .reveal-up {
    opacity: 0;
    transform: translateY(30px);
    animation: revealUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes revealUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .container {
      padding: 0 40px;
    }

    .page-banner {
      min-height: 45vh;
      padding-top: 130px;
      padding-bottom: 60px;
    }
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 24px;
    }

    .page-banner {
      min-height: 40vh;
      padding-top: 120px;
      padding-bottom: 80px;
    }

    .page-banner__title {
      font-size: 2rem;
    }

    .page-banner__subtitle {
      font-size: 0.95rem;
    }

    .section-badge {
      font-size: 0.6rem;
    }

    .breadcrumb {
      font-size: 0.7rem;
    }
  }

  @media (min-width: 1400px) {
    .container {
      padding: 0 80px;
    }
  }
</style>