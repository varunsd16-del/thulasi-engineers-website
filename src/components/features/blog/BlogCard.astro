---
interface Props {
  post: any;
  categorySlug?: string;
}

const { post, categorySlug } = Astro.props;
const { data, slug } = post;
const formattedDate = data.pubDate.toLocaleDateString('en-IN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<div class="blog-card reveal-up">
  <div class="blog-card__img">
    <img src={data.image} alt={data.title} loading="lazy" />
    <div class="blog-card__category">{data.category?.replace('-', ' ') || data.category}</div>
  </div>
  <div class="blog-card__content">
    <div class="blog-card__meta">
      <span class="date">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        {formattedDate}
      </span>
      <span class="author">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
        By {data.author}
      </span>
    </div>
    <h3 class="blog-card__title">
      <a href={`/blog/${data.category}/${slug}`}>{data.title}</a>
    </h3>
    <p class="blog-card__desc">{data.description}</p>
    <a href={`/blog/${data.category}/${slug}`} class="blog-card__link">
      READ ARTICLE
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="5" y1="12" x2="19" y2="12"/>
        <polyline points="12 5 19 12 12 19"/>
      </svg>
    </a>
  </div>
</div>

<style>
  :root {
    --navy: #0d1b3e;
    --gold: #c5a059;
    --gold-light: #d4af37;
    --text-muted: #4b5563;
    --bg-white: #ffffff;
    --border-light: rgba(13, 27, 62, 0.08);
  }

  .blog-card {
    background: var(--bg-white);
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--border-light);
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    height: 100%;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
  }

  .blog-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 35px rgba(13, 27, 62, 0.08);
    border-color: rgba(197, 160, 89, 0.3);
  }

  .blog-card__img {
    position: relative;
    height: 220px;
    overflow: hidden;
  }

  .blog-card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .blog-card:hover .blog-card__img img {
    transform: scale(1.05);
  }

  .blog-card__category {
    position: absolute;
    top: 16px;
    right: 16px;
    background: var(--gold);
    color: var(--navy);
    font-size: 0.6rem;
    font-weight: 800;
    padding: 5px 12px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    z-index: 2;
    transition: all 0.3s ease;
  }

  .blog-card:hover .blog-card__category {
    background: var(--gold-light);
    transform: translateY(-2px);
  }

  .blog-card__content {
    padding: 28px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .blog-card__meta {
    display: flex;
    gap: 20px;
    font-size: 0.7rem;
    color: var(--text-muted);
    margin-bottom: 15px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .blog-card__meta span {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .blog-card__meta svg {
    width: 14px;
    height: 14px;
    stroke: var(--gold);
  }

  .blog-card__title {
    font-size: 1.2rem;
    line-height: 1.4;
    margin-bottom: 12px;
    font-weight: 800;
  }

  .blog-card__title a {
    color: var(--navy);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .blog-card__title a:hover {
    color: var(--gold);
  }

  .blog-card__desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 20px;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.7rem;
    font-weight: 800;
    color: var(--navy);
    text-decoration: none;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: all 0.3s ease;
  }

  .blog-card__link svg {
    width: 16px;
    height: 16px;
    stroke: var(--gold);
    transition: transform 0.3s ease;
  }

  .blog-card__link:hover {
    color: var(--gold);
    gap: 12px;
  }

  .blog-card__link:hover svg {
    transform: translateX(4px);
  }

  /* Reveal Animation (if parent handles it) */
  .reveal-up {
    opacity: 0;
    transform: translateY(30px);
    animation: revealUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes revealUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>